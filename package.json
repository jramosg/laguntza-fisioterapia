{
	"name": "laguntza-fisioterapia",
	"version": "3.1.0",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git@github.com:treefarmstudio/laguntza-fisioterapia"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "node ./dist/server/entry.mjs",
		"build": "astro build",
		"preview": "astro preview",
		"format": "npx prettier -w .",
		"format:check": "prettier . --check",
		"test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
		"check-updates": "pnpm outdated --long",
		"check": "astro sync && tsc --noEmit",
		"test:integration": "node --test tests/integration/*.test.mjs"
	},
	"devDependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@iconify-json/ic": "^1.2.4",
		"@iconify-json/mdi": "^1.2.3",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"astro-icon": "^1.2.0",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.12",
		"@fontsource-variable/inter": "^5.3.0",
		"astro": "^7.4.11",
		"gsap": "^3.15.1",
		"leaflet": "^1.9.4",
		"resend": "^6.38.0",
		"three": "^0.187.0"
	},
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.23.4"
	}
}
