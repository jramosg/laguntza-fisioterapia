{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
	"exclude": ["dist"],
	"compilerOptions": {
		"types": ["astro/client"],
		"paths": {
			"@config/*": ["./src/config/*"],
			"@lib/*": ["./src/lib/*"],
			"@utils/*": ["./src/utils/*"],
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@pages/*": ["./src/pages/*"],
			"@styles/*": ["./src/styles/*"],
			"@i18n/*": ["./src/i18n/*"],
			"@images/*": ["./src/images/*"],
			"@icons/*": ["./src/icons/*"],
			"@videos/*": ["./src/videos/*"],
			"@types": ["./src/types"]
		}
	}
}
