---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
const lang = getLangFromUrl(Astro.url);
const eu = lang === 'eu';
---

<laguntza-contact data-lang={lang}>
	<div class="form-heading">
		<p class="ed-kicker">
			{eu ? 'NAHIAGO BADUZU, IDATZI' : 'SI PREFIERES, ESCRÍBEME'}
		</p>
		<h2>
			{eu ? 'Mezu batekin has gaitezke.' : 'Podemos empezar con un mensaje.'}
		</h2>
		<p>
			{eu
				? 'Utzi zure datuak eta zurekin harremanetan jarriko naiz.'
				: 'Déjame tus datos y me pondré en contacto contigo.'}
		</p>
	</div>
	<form id="contactForm">
		<input type="hidden" name="lang" value={lang} />
		<div class="contact-trap" aria-hidden="true">
			<label for="contact-website">Website</label>
			<input
				id="contact-website"
				name="website"
				type="text"
				tabindex="-1"
				autocomplete="off"
			/>
		</div>
		<div class="form-row">
			<div class="field">
				<label for="name">
					{eu ? 'Izena' : 'Nombre'} <span>*</span>
				</label>
				<input
					id="name"
					name="name"
					autocomplete="name"
					required
					maxlength="120"
					placeholder={eu ? 'Zure izena' : 'Tu nombre'}
				/>
			</div>
			<div class="field">
				<label for="email">
					Email <span>*</span>
				</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					inputmode="email"
					required
					maxlength="254"
					placeholder={eu ? 'Zure emaila' : 'Tu email'}
				/>
			</div>
		</div>
		<div class="field">
			<label for="phone">
				{eu ? 'Telefonoa' : 'Teléfono'}
				<small>{eu ? 'aukerakoa' : 'opcional'}</small>
			</label>
			<input
				id="phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				inputmode="tel"
				maxlength="32"
				placeholder="688 734 113"
			/>
		</div>
		<div class="field">
			<label for="message">
				{eu ? 'Nola lagun zaitzaket?' : '¿En qué puedo ayudarte?'}
				<span>*</span>
			</label>
			<textarea
				id="message"
				name="message"
				required
				maxlength="6000"
				rows="4"
				placeholder={
					eu
						? 'Lehen hitzordua hartu nahiko nuke…'
						: 'Me gustaría pedir una primera cita…'
				}
			></textarea>
		</div>
		<details class="attachment-options">
			<summary>
				<Icon name="mdi:paperclip" aria-hidden="true" />
				{eu ? 'Fitxategi bat erantsi' : 'Adjuntar un archivo'}
				<small>{eu ? 'aukerakoa' : 'opcional'}</small>
			</summary>
			<label for="attachments" class="file-help">
				{eu
					? 'JPG, PNG, PDF, DOC edo TXT · 10 MiB fitxategiko · 15 MiB guztira · 3 fitxategi gehienez'
					: 'JPG, PNG, PDF, DOC o TXT · 10 MiB por archivo · 15 MiB en total · Hasta 3 archivos'}
			</label>
			<input
				type="file"
				id="attachments"
				name="attachments"
				accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
				multiple
			/>
		</details>
		<p class="form-privacy">
			{eu
				? 'Arduraduna: Jokin Ramos Gonzalez. Zure kontsulta eta hitzordu-eskaera kudeatzeko erabiliko ditugu datuak, zuk eskatutako zerbitzua kudeatzeko oinarrian. Bidalketa Resend bidez egiten da, eta datuak EEEtik kanpo prozesa ditzake. Zure eskubideak info@laguntzafisioterapia.com helbidean erabil ditzakezu.'
				: 'Responsable: Jokin Ramos Gonzalez. Usaremos tus datos para atender tu consulta y solicitud de cita, sobre la base de gestionar el servicio que solicitas. El envío se realiza mediante Resend, que puede procesar datos fuera del EEE. Puedes ejercer tus derechos en info@laguntzafisioterapia.com.'}
			<a href={`/${lang}/privacy/`}>
				{eu
					? 'Pribatutasunari buruzko informazioa'
					: 'Información de privacidad'}
			</a>
			.
		</p>
		<div class="form-bottom">
			<small>{eu ? '* Derrigorrezko eremuak' : '* Campos obligatorios'}</small>
			<button type="submit" class="ed-pill">
				<span data-submit-label>{eu ? 'Mezua bidali' : 'Enviar mensaje'}</span>
				<Icon name="mdi:arrow-top-right" aria-hidden="true" />
			</button>
		</div>
	</form>
	<div
		class="form-status"
		role="status"
		aria-live="polite"
		tabindex="-1"
		hidden
	></div>
	<noscript>
		<p>
			{eu
				? 'Formularioak JavaScript behar du. Telefonoz edo WhatsApp bidez harremanetan jar zaitezke.'
				: 'El formulario necesita JavaScript. Puedes contactar por teléfono o WhatsApp.'}
		</p>
	</noscript>
</laguntza-contact>
<style>
	.form-privacy {
		font-size: 12px;
		line-height: 1.7;
		color: var(--lf-muted);
		margin: 24px 0;
	}
	.form-privacy a {
		color: var(--lf-ink);
		text-underline-offset: 0.2em;
	}
	laguntza-contact {
		display: block;
	}
	.contact-trap {
		display: none;
	}
	.form-heading {
		margin-bottom: 38px;
	}
	.form-heading h2 {
		font-size: clamp(30px, 3vw, 42px);
		line-height: 1.15;
		letter-spacing: -0.05em;
		max-width: 480px;
		margin: 0 0 18px;
	}
	.form-heading > p:last-child {
		font-size: 15px;
		color: var(--lf-muted);
		margin: 0;
	}
	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
	}
	.field {
		margin-bottom: 26px;
	}
	label {
		display: block;
		font-size: 13px;
		font-weight: 500;
		margin-bottom: 10px;
	}
	label span {
		color: var(--lf-warm-text, #85501f);
	}
	label small,
	summary small {
		font-size: 11px;
		font-weight: 400;
		color: var(--lf-muted);
		margin-left: 8px;
	}
	input:not([type='file']),
	textarea {
		display: block;
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--lf-border-strong, #a6b5ac);
		background: var(--lf-field-surface, #eef1eb80);
		color: var(--lf-ink);
		padding: 16px;
		min-height: 54px;
		font: inherit;
		font-size: 16px;
		line-height: 1.6;
		border-radius: 4px 4px 0 0;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	textarea {
		resize: vertical;
		min-height: 145px;
	}
	input::placeholder,
	textarea::placeholder {
		color: var(--lf-text-muted, #5c6b64);
		font-size: 14px;
	}
	input:focus,
	textarea:focus {
		background: var(--lf-surface-soft, #eef1eb);
		border-color: var(--lf-text-accent, #37697a);
		outline: 2px solid var(--lf-text-accent, #37697a);
		outline-offset: 2px;
	}
	.attachment-options {
		margin-block: 4px 30px;
	}
	.attachment-options summary {
		list-style: none;
		cursor: pointer;
		min-height: 44px;
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
	}
	.attachment-options summary::-webkit-details-marker {
		display: none;
	}
	.attachment-options summary svg {
		width: 18px;
		height: 18px;
	}
	.file-help {
		font-size: 11px;
		color: var(--lf-muted);
		font-weight: 400;
		margin-top: 12px;
	}
	input[type='file'] {
		display: block;
		width: 100%;
		font-size: 12px;
		padding: 14px 0;
	}
	.form-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		border-top: 1px solid var(--lf-line);
		padding-top: 25px;
	}
	.form-bottom > small {
		font-size: 10px;
		color: var(--lf-muted);
	}
	.form-status {
		font-size: 15px;
		padding: 24px;
		background: var(--lf-success-surface, #e3ece7);
		border-radius: 12px;
		margin-top: 24px;
		line-height: 1.8;
	}
	.form-status[data-error] {
		background: var(--lf-error-surface, #f8e9df);
		color: var(--lf-error-text, #733a24);
	}
	.form-status[hidden] {
		display: none;
	}
	button[aria-busy='true'] svg {
		animation: busy 1.2s linear infinite;
	}
	@keyframes busy {
		to {
			transform: rotate(360deg);
		}
	}
	@media (max-width: 500px) {
		.form-row {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.form-heading h2 {
			font-size: 33px;
		}
		.form-bottom {
			gap: 14px;
		}
		.form-bottom .ed-pill {
			gap: 20px;
			padding-inline: 20px;
		}
	}
</style>
<script>
	import './contact-form';
</script>
