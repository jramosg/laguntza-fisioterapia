---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
const lang = getLangFromUrl(Astro.url);
const eu = lang === 'eu';
---

<laguntza-contact data-lang={lang}>
	<div class="form-heading">
		<p class="ed-kicker">
			{eu ? 'NAHIAGO BADUZU, IDATZI' : 'SI PREFIERES, ESCRÍBEME'}
		</p>
		<h2>
			{eu ? 'Mezu batekin has gaitezke.' : 'Podemos empezar con un mensaje.'}
		</h2>
		<p>
			{eu
				? 'Utzi zure datuak eta zurekin harremanetan jarriko naiz.'
				: 'Déjame tus datos y me pondré en contacto contigo.'}
		</p>
	</div>
	<form id="contactForm">
		<input type="hidden" name="lang" value={lang} />
		<div class="contact-trap" aria-hidden="true">
			<label for="contact-website">Website</label>
			<input
				id="contact-website"
				name="website"
				type="text"
				tabindex="-1"
				autocomplete="off"
			/>
		</div>
		<div class="form-row">
			<div class="field">
				<label for="name">
					{eu ? 'Izena' : 'Nombre'} <span>*</span>
				</label>
				<input
					id="name"
					name="name"
					autocomplete="name"
					required
					maxlength="120"
					placeholder={eu ? 'Zure izena' : 'Tu nombre'}
				/>
			</div>
			<div class="field">
				<label for="email">
					Email <span>*</span>
				</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					inputmode="email"
					required
					maxlength="254"
					placeholder={eu ? 'Zure emaila' : 'Tu email'}
				/>
			</div>
		</div>
		<div class="field">
			<label for="phone">
				{eu ? 'Telefonoa' : 'Teléfono'}
				<small>{eu ? 'aukerakoa' : 'opcional'}</small>
			</label>
			<input
				id="phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				inputmode="tel"
				maxlength="32"
				placeholder="688 734 113"
			/>
		</div>
		<div class="field">
			<label for="message">
				{eu ? 'Nola lagun zaitzaket?' : '¿En qué puedo ayudarte?'}
				<span>*</span>
			</label>
			<textarea
				id="message"
				name="message"
				required
				maxlength="6000"
				rows="4"
				placeholder={
					eu
						? 'Lehen hitzordua hartu nahiko nuke…'
						: 'Me gustaría pedir una primera cita…'
				}
			></textarea>
		</div>
		<div class="attachment-options">
			<div class="attachment-heading">
				<span>{eu ? 'Dokumentuak' : 'Documentos'}</span>
				<small>{eu ? 'Aukerakoa' : 'Opcional'}</small>
			</div>
			<button
				type="button"
				class="attachment-picker"
				data-attachment-picker
				aria-controls="attachment-list"
				aria-describedby="attachment-help attachment-error"
			>
				<span class="attachment-upload-icon">
					<Icon name="mdi:tray-arrow-up" aria-hidden="true" />
				</span>
				<span class="attachment-picker-copy">
					<strong>{eu ? 'Fitxategiak erantsi' : 'Adjuntar archivos'}</strong>
					<span class="attachment-drop-hint">
						{eu ? 'edo arrastatu hona' : 'o arrástralos aquí'}
					</span>
				</span>
				<Icon name="mdi:plus" class="attachment-plus" aria-hidden="true" />
			</button>
			<input
				type="file"
				id="attachments"
				name="attachments"
				accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
				multiple
				hidden
			/>
			<div id="attachment-help" class="file-help">
				<span>JPG, PNG, PDF, DOC, DOCX, TXT</span>
				<span>
					{eu
						? '3 fitxategi gehienez · 10 MiB bakoitzeko · 15 MiB guztira'
						: 'Hasta 3 archivos · 10 MiB por archivo · 15 MiB en total'}
				</span>
			</div>
			<ul
				id="attachment-list"
				class="attachment-list"
				aria-label={eu ? 'Erantsitako fitxategiak' : 'Archivos adjuntos'}
				hidden
			></ul>
			<p class="attachment-count" data-attachment-count role="status"></p>
			<p id="attachment-error" class="attachment-error" role="alert" hidden></p>
			<template data-attachment-template>
				<li class="attachment-file">
					<span class="attachment-file-icon">
						<Icon name="mdi:file-document-outline" aria-hidden="true" />
					</span>
					<span class="attachment-file-copy">
						<span class="attachment-file-name" data-file-name></span>
						<span class="attachment-file-size" data-file-size></span>
					</span>
					<button type="button" class="attachment-remove" data-file-remove>
						<Icon name="mdi:close" aria-hidden="true" />
					</button>
				</li>
			</template>
		</div>
		<div class="form-privacy">
			<p id="privacy-summary" class="privacy-summary">
				{eu
					? 'Jokin Ramos Gonzalez · Zure kontsulta edo hitzordua kudeatzeko, eskatutako zerbitzuaren barruan. Hartzaileak: kontsulta eta posta-hornitzailea; nazioarteko transferentziak egon daitezke. Eskubideak: info@laguntzafisioterapia.com.'
					: 'Jokin Ramos Gonzalez · Para atender tu consulta o cita, como parte del servicio solicitado. Destinatarios: la consulta y su proveedor de correo; posibles transferencias internacionales. Derechos: info@laguntzafisioterapia.com.'}
			</p>
			<label class="privacy-acknowledgement" for="privacy-acknowledged">
				<input
					type="checkbox"
					id="privacy-acknowledged"
					name="privacyAcknowledged"
					value="informed"
					aria-describedby="privacy-summary"
					required
				/>
				<span>
					{!eu && 'Confirmo que he recibido la '}
					<a
						href={`/${lang}/privacy/`}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={
							eu
								? 'Pribatutasunari buruzko informazioa (beste fitxa batean irekitzen da)'
								: 'Información de privacidad (se abre en otra pestaña)'
						}
					>
						{eu
							? 'Pribatutasunari buruzko informazioa'
							: 'información de privacidad'}
					</a>
					{eu && ' jaso dudala berresten dut'}
				</span>
			</label>
		</div>
		<div class="form-bottom">
			<small>{eu ? '* Derrigorrezko eremuak' : '* Campos obligatorios'}</small>
			<button type="submit" class="ed-pill">
				<span data-submit-label>{eu ? 'Mezua bidali' : 'Enviar mensaje'}</span>
				<Icon name="mdi:arrow-top-right" aria-hidden="true" />
			</button>
		</div>
	</form>
	<div
		class="form-status"
		role="status"
		aria-live="polite"
		tabindex="-1"
		hidden
	></div>
	<noscript>
		<p>
			{eu
				? 'Formularioak JavaScript behar du. Telefonoz edo WhatsApp bidez harremanetan jar zaitezke.'
				: 'El formulario necesita JavaScript. Puedes contactar por teléfono o WhatsApp.'}
		</p>
	</noscript>
</laguntza-contact>
<style>
	.form-privacy {
		font-size: 12px;
		line-height: 1.7;
		color: var(--lf-muted);
		margin: 24px 0;
	}
	.form-privacy a {
		color: var(--lf-ink);
		text-underline-offset: 0.2em;
	}
	.privacy-summary {
		margin: 0 0 10px;
	}
	.privacy-acknowledgement {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		min-height: 44px;
		padding-block: 10px;
		margin: 0;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.6;
		cursor: pointer;
	}
	.privacy-acknowledgement span {
		color: var(--lf-ink);
	}
	input[type='checkbox'] {
		flex: 0 0 20px;
		width: 20px;
		height: 20px;
		margin: 1px 0 0;
		accent-color: var(--lf-text-accent, #37697a);
		cursor: pointer;
	}
	laguntza-contact {
		display: block;
	}
	.contact-trap {
		display: none;
	}
	.form-heading {
		margin-bottom: 38px;
	}
	.form-heading h2 {
		font-size: clamp(30px, 3vw, 42px);
		line-height: 1.15;
		letter-spacing: -0.05em;
		max-width: 480px;
		margin: 0 0 18px;
	}
	.form-heading > p:last-child {
		font-size: 15px;
		color: var(--lf-muted);
		margin: 0;
	}
	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
	}
	.field {
		margin-bottom: 26px;
	}
	label {
		display: block;
		font-size: 13px;
		font-weight: 500;
		margin-bottom: 10px;
	}
	label span {
		color: var(--lf-warm-text, #85501f);
	}
	label small {
		font-size: 11px;
		font-weight: 400;
		color: var(--lf-muted);
		margin-left: 8px;
	}
	input:not([type='file']):not([type='checkbox']),
	textarea {
		display: block;
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--lf-border-strong, #a6b5ac);
		background: var(--lf-field-surface, #eef1eb80);
		color: var(--lf-ink);
		padding: 16px;
		min-height: 54px;
		font: inherit;
		font-size: 16px;
		line-height: 1.6;
		border-radius: 4px 4px 0 0;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	textarea {
		resize: vertical;
		min-height: 145px;
	}
	input::placeholder,
	textarea::placeholder {
		color: var(--lf-text-muted, #5c6b64);
		font-size: 14px;
	}
	input:focus,
	textarea:focus {
		background: var(--lf-surface-soft, #eef1eb);
		border-color: var(--lf-text-accent, #37697a);
		outline: 2px solid var(--lf-text-accent, #37697a);
		outline-offset: 2px;
	}
	.attachment-options {
		margin-block: 4px 30px;
	}
	.attachment-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
		font-size: 13px;
		font-weight: 500;
	}
	.attachment-heading small {
		font-size: 10px;
		font-weight: 400;
		color: var(--lf-muted);
		border: 1px solid var(--lf-line);
		border-radius: 30px;
		padding: 3px 9px;
	}
	.attachment-picker {
		display: flex;
		align-items: center;
		gap: 16px;
		width: 100%;
		min-height: 100px;
		padding: 22px;
		border: 1px dashed var(--lf-border-strong, #a6b5ac);
		border-radius: 16px;
		background: var(--lf-field-surface, #eef1eb80);
		color: var(--lf-ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.attachment-picker:hover,
	.attachment-options[data-dragging] .attachment-picker {
		border-color: var(--lf-teal);
		background: var(--lf-surface-accent, #dce7e6);
	}
	.attachment-picker:focus-visible,
	.attachment-remove:focus-visible {
		outline: 2px solid var(--lf-teal);
		outline-offset: 4px;
	}
	.attachment-upload-icon,
	.attachment-file-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		color: var(--lf-teal);
		background: var(--lf-surface-accent, #dce7e6);
		border-radius: 12px;
		width: 46px;
		height: 46px;
	}
	.attachment-upload-icon svg {
		width: 24px;
		height: 24px;
	}
	.attachment-picker-copy,
	.attachment-file-copy {
		display: grid;
		gap: 5px;
		min-width: 0;
		flex: 1;
	}
	.attachment-picker-copy strong {
		font-size: 14px;
		font-weight: 500;
	}
	.attachment-drop-hint {
		font-size: 12px;
		color: var(--lf-muted);
	}
	.attachment-picker .attachment-plus {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		color: var(--lf-teal);
	}
	.file-help {
		display: grid;
		gap: 3px;
		font-size: 11px;
		color: var(--lf-muted);
		margin-top: 12px;
		line-height: 1.7;
	}
	.attachment-list {
		list-style: none;
		padding: 0;
		margin: 18px 0 0;
		display: grid;
		gap: 8px;
	}
	.attachment-list[hidden],
	.attachment-error[hidden] {
		display: none;
	}
	.attachment-file {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 8px 10px 12px;
		border: 1px solid var(--lf-line);
		border-radius: 12px;
		background: var(--lf-paper);
	}
	.attachment-file-icon {
		width: 36px;
		height: 42px;
		border-radius: 8px;
	}
	.attachment-file-icon svg {
		width: 20px;
		height: 20px;
	}
	.attachment-file-name {
		font-size: 12px;
		font-weight: 500;
		overflow-wrap: anywhere;
	}
	.attachment-file-size {
		font-size: 11px;
		color: var(--lf-muted);
	}
	.attachment-remove {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--lf-muted);
		cursor: pointer;
	}
	.attachment-remove:hover {
		background: var(--lf-surface-soft, #eef1eb);
		color: var(--lf-ink);
	}
	.attachment-remove svg {
		width: 18px;
		height: 18px;
	}
	.attachment-options .attachment-count,
	.attachment-options .attachment-error {
		font-size: 11px;
		line-height: 1.7;
		margin: 10px 0 0;
	}
	.attachment-count {
		color: var(--lf-muted);
	}
	.attachment-count:empty {
		margin: 0;
	}
	.attachment-error {
		color: var(--lf-error-text, #733a24);
		background: var(--lf-error-surface, #f8e9df);
		border-radius: 10px;
		padding: 12px 14px;
	}
	@media (pointer: coarse) {
		.attachment-drop-hint {
			display: none;
		}
	}
	.form-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		border-top: 1px solid var(--lf-line);
		padding-top: 25px;
	}
	.form-bottom > small {
		font-size: 10px;
		color: var(--lf-muted);
	}
	.form-status {
		font-size: 15px;
		padding: 24px;
		background: var(--lf-success-surface, #e3ece7);
		border-radius: 12px;
		margin-top: 24px;
		line-height: 1.8;
	}
	.form-status[data-error] {
		background: var(--lf-error-surface, #f8e9df);
		color: var(--lf-error-text, #733a24);
	}
	.form-status[hidden] {
		display: none;
	}
	button[aria-busy='true'] svg {
		animation: busy 1.2s linear infinite;
	}
	@keyframes busy {
		to {
			transform: rotate(360deg);
		}
	}
	@media (max-width: 500px) {
		.form-row {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.form-heading h2 {
			font-size: 33px;
		}
		.form-bottom {
			gap: 14px;
		}
		.form-bottom .ed-pill {
			gap: 20px;
			padding-inline: 20px;
		}
	}
</style>
<script>
	import './contact-form';
</script>
