---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { Practitioner } from '@config/practitioner';
import { useTranslations } from '@i18n/utils';
import Rehab from '@images/rehab.webp';
import Interview from '@images/interview.webp';
interface Props {
	lang: 'eu' | 'es';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const chapters = ['journey', 'philosophy', 'community'];
---

<article class="ed-shell ed-section about-story">
	<div class="story-rail ed-sticky">
		<p class="ed-kicker">JOKIN RAMOS GONZÁLEZ</p><p class="registration">
			{
				lang === 'eu' ? 'Fisioterapeuta kolegiatua' : 'Fisioterapeuta colegiado'
			}<br /><span>COFPV · {Practitioner.registrationNumber}</span>
		</p><a class="ed-link" href="#formacion"
			>{lang === 'eu' ? 'Nire prestakuntza' : 'Mi formación'}<Icon
				name="mdi:arrow-down"
				aria-hidden="true"
			/></a
		><figure class="story-photo" data-parallax>
			<Image
				src={Interview}
				alt={lang === 'eu'
					? 'Jokin paziente baten balorazioa prestatzen'
					: 'Jokin preparando la valoración de un paciente'}
				width={700}
				widths={[400, 700]}
				sizes="(max-width:760px) 80vw, 30vw"
			/>
		</figure>
	</div>
	<div>
		<p class="ed-lead ed-reveal story-lead">{t('about.intro')}</p>{
			chapters.map((chapter, i) => (
				<section class="story-chapter ed-reveal">
					<p>{t(`about.${chapter}-text`)}</p>
					{i === 0 && <p>{Practitioner.sportsRole[lang]}</p>}
				</section>
			))
		}
	</div>
</article>
<section class="ed-dark ed-section" id="formacion">
	<div class="ed-shell qualifications-layout">
		<div class="ed-reveal">
			<p class="ed-kicker">
				{lang === 'eu' ? 'ETENGABE IKASTEN' : 'SEGUIR APRENDIENDO'}
			</p><h2 class="ed-heading">
				{lang === 'eu' ? 'Zaintzeko,' : 'Formarme para'}<br /><span
					>{lang === 'eu' ? 'prestatzen.' : 'cuidarte mejor.'}</span
				>
			</h2><p class="qualification-note">
				{Practitioner.collegeNameLocalized[lang]}<br />COFPV · {
					Practitioner.registrationNumber
				}
			</p>
		</div><ol class="qualifications" role="list">
			{
				Practitioner.qualifications.map((qualification, i) => (
					<li class="ed-reveal">
						<>
							<span>0{i + 1}</span>
							<p>{qualification[lang]}</p>
						</>
					</li>
				))
			}
		</ol>
	</div>
</section>
<section class="ed-shell ed-section personal-note ed-reveal">
	<figure class="personal-photo" data-parallax>
		<Image
			src={Rehab}
			alt={lang === 'eu'
				? 'Jokin paziente batekin eskuzko tratamendu batean'
				: 'Jokin trabajando con una paciente durante un tratamiento manual'}
			width={1000}
			widths={[400, 700, 1000]}
			sizes="(max-width:760px) 100vw, 50vw"
		/>
	</figure><div>
		<p class="ed-kicker">
			{lang === 'eu' ? 'LAGUNTZA, URNIETAN' : 'LAGUNTZA, EN URNIETA'}
		</p><p class="ed-lead">
			{
				lang === 'eu'
					? 'Tratamenduaren atzean, beti pertsona bat. Eta aurrean, zu.'
					: 'Detrás del tratamiento, siempre una persona. Y delante, tú.'
			}
		</p>
	</div>
</section>
<style>
	.about-story {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 120px;
		align-items: start;
	}
	.registration {
		font-size: 15px;
		color: var(--lf-muted);
		line-height: 1.8;
		margin: 0 0 18px;
	}
	.registration span {
		color: var(--lf-teal);
	}
	.story-photo {
		margin: 40px 0 0;
		border-radius: 20px 80px 20px 20px;
		overflow: hidden;
		height: 300px;
	}
	.story-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 25% center;
	}
	.story-lead {
		margin-bottom: 48px;
	}
	.story-chapter {
		border-top: 1px solid var(--lf-line);
		padding-top: 28px;
		margin-top: 36px;
	}
	.story-chapter > span {
		font-size: 10px;
		color: var(--lf-teal);
	}
	.story-chapter h2 {
		font-size: 30px;
		margin: 14px 0 20px;
	}
	.story-chapter p {
		font-size: 16px;
		color: var(--lf-muted);
		margin-bottom: 18px;
	}
	.qualifications-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 100px;
	}
	.qualifications-layout .ed-heading {
		color: #f6f5ee;
	}
	.qualifications-layout h2 span {
		color: #a3c6d3;
	}
	.qualification-note {
		font-size: 12px;
		line-height: 1.8;
		color: #a9b2ae;
		margin-top: 32px;
		max-width: 300px;
	}
	.qualifications {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.qualifications li {
		display: flex;
		gap: 24px;
		align-items: baseline;
		border-top: 1px solid #ffffff26;
		padding: 24px 0;
	}
	.qualifications li:last-child {
		border-bottom: 1px solid #ffffff26;
	}
	.qualifications li > span {
		font-size: 10px;
		color: #e8944a;
	}
	.qualifications p {
		font-size: 18px;
		letter-spacing: -0.025em;
		margin: 0;
	}
	.personal-note {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 100px;
		align-items: center;
	}
	.personal-photo {
		height: 400px;
		border-radius: 20px 20px 90px 20px;
		overflow: hidden;
		margin: 0;
	}
	.personal-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% center;
	}
	@media (max-width: 1100px) {
		.about-story {
			gap: 64px;
		}
		.qualifications-layout,
		.personal-note {
			gap: 50px;
		}
	}
	@media (max-width: 760px) {
		.about-story,
		.qualifications-layout,
		.personal-note {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.story-photo {
			display: none;
		}
		.story-rail .ed-kicker {
			margin-bottom: 12px;
		}
		.story-lead {
			font-size: 24px;
		}
		.qualifications p {
			font-size: 16px;
		}
		.personal-photo {
			height: 320px;
		}
		.personal-note .ed-lead {
			font-size: 25px;
		}
	}
</style>
