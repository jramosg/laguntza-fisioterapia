---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
import { home } from '@config/home';
import { WhatsApp } from '@config/company';
const {
	id,
	image,
	imageAlt = '',
	imagePosition = 'center',
	imageMobile,
	imageMobilePosition,
	imageLayout = 'wide',
	showImageCaption = true,
	eyebrow,
	book = true,
	compact = false
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const c = home[lang];
const isService = Astro.url.pathname.split('/').filter(Boolean).length > 2;
const section = Astro.url.pathname.split('/').filter(Boolean)[1];
const pageLabel =
	c.services.find(service => Astro.url.pathname.includes(service.slug))
		?.title ||
	(
		{
			services: c.nav[0],
			about: c.nav[1],
			consulta: c.nav[2],
			contact: c.nav[3]
		} as Record<string, string>
	)[section] ||
	c.nav[0];
const mobile = imageMobile
	? await getImage({
			src: imageMobile,
			width: Math.min(800, imageMobile.width),
			format: 'webp'
		})
	: null;
const maxImageWidth = image
	? Math.min(image.width, imageLayout === 'portrait' ? 1600 : 2880)
	: 0;
const imageWidths = [640, 960, 1280, 1600, 1920, 2560].filter(
	width => width < maxImageWidth
);
if (maxImageWidth) imageWidths.push(maxImageWidth);
const bookingUrl = `${WhatsApp.url}?text=${encodeURIComponent(c.whatsappMessage)}`;
---

<section {id} class:list={['ed-hero', { 'ed-hero--compact': compact }]}>
	<div class:list={['ed-shell', { 'hero-split': imageLayout === 'portrait' }]}>
		<nav
			class="hero-breadcrumb"
			aria-label={lang === 'eu' ? 'Nabigazio bidea' : 'Ruta de navegación'}
		>
			<a href={`/${lang}/`}>Laguntza</a><span>/</span>{
				isService && (
					<>
						<>
							<a href={`/${lang}/services/`}>{c.nav[0]}</a>
							<span>/</span>
						</>
					</>
				)
			}<span>{eyebrow || pageLabel}</span>
		</nav>
		<div class="hero-type">
			<div>
				<p class="ed-kicker">
					{
						lang === 'eu'
							? 'FISIOTERAPIA · URNIETA, GIPUZKOA'
							: 'FISIOTERAPIA · URNIETA, GIPUZKOA'
					}
				</p><slot name="title" />
			</div><div class="hero-aside">
				<p><slot name="desc" /></p>{
					book && (
						<a
							class="ed-pill"
							href={bookingUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							{c.book}
							<Icon name="mdi:arrow-top-right" aria-hidden="true" />
						</a>
					)
				}<slot name="chips" />
			</div>
		</div>
		{
			image && (
				<figure
					class="hero-photo"
					data-parallax={imageLayout === 'portrait' ? undefined : ''}
				>
					<>
						<picture>
							{mobile && (
								<source media="(max-width:760px)" srcset={mobile.src} />
							)}
							<Image
								src={image}
								alt={imageAlt}
								priority
								width={Math.min(1600, image.width)}
								widths={imageWidths}
								quality={85}
								sizes={
									imageLayout === 'portrait'
										? '(max-width:760px) calc(100vw - 48px), (max-width:1100px) 42vw, 480px'
										: '(max-width:760px) calc(100vw - 48px), (max-width:1440px) calc(100vw - 128px), 1312px'
								}
								style={`--hero-pos:${imagePosition};--hero-pos-m:${imageMobilePosition || imagePosition}`}
							/>
						</picture>
						{showImageCaption && (
							<figcaption>
								Laguntza Fisioterapia <span>Urnieta · 20130</span>
							</figcaption>
						)}
					</>
				</figure>
			)
		}
	</div>
</section>
<style>
	.ed-hero {
		padding-top: 34px;
		padding-bottom: 10px;
	}
	.hero-breadcrumb {
		display: flex;
		gap: 12px;
		align-items: center;
		flex-wrap: wrap;
		font-size: 11px;
		color: var(--lf-text-muted, #66756e);
		margin-bottom: 60px;
	}
	.hero-breadcrumb a {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.hero-breadcrumb a:hover {
		color: var(--lf-text-accent, #37697a);
	}
	.hero-breadcrumb > span:last-child {
		color: var(--lf-text-primary, #263432);
	}
	.hero-type {
		display: grid;
		grid-template-columns: 1.5fr 0.8fr;
		gap: 80px;
		align-items: end;
		margin-bottom: 56px;
	}
	.hero-type .ed-kicker {
		margin-bottom: 26px;
	}
	.hero-type :global(h1) {
		font-size: clamp(48px, 5.8vw, 84px);
		line-height: 1.04;
		letter-spacing: -0.065em;
		color: var(--lf-text-primary, #263432);
		max-width: 900px;
		margin: 0;
	}
	.hero-type :global(h1 span) {
		color: var(--lf-text-accent, #37697a);
	}
	.hero-aside > p {
		margin: 0 0 26px;
		color: var(--lf-text-muted, #5c6b64);
		font-size: 16px;
		line-height: 1.85;
	}
	.hero-aside :global(.chip) {
		margin: 8px 8px 0 0;
	}
	.hero-photo {
		position: relative;
		overflow: hidden;
		height: 390px;
		border-radius: 22px 22px 100px 22px;
		margin: 0;
		background: var(--lf-surface-soft, #e3e8e2);
	}
	.hero-photo picture {
		display: contents;
	}
	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--hero-pos, center);
	}
	.hero-photo figcaption {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		display: flex;
		justify-content: space-between;
		padding: 32px;
		color: #fff;
		background: linear-gradient(#0a0e1080, #0a0e10d9);
		font-size: 11px;
	}
	.ed-hero--compact .hero-breadcrumb {
		margin-bottom: 38px;
	}
	.hero-split {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		column-gap: 80px;
		align-items: start;
	}
	.hero-split .hero-breadcrumb {
		grid-column: 1 / -1;
		margin-bottom: 40px;
	}
	.hero-split .hero-type {
		display: block;
		margin-bottom: 0;
		padding-top: 56px;
	}
	.hero-split .hero-type :global(h1) {
		font-size: clamp(44px, 4.3vw, 66px);
	}
	.hero-split .hero-aside {
		max-width: 460px;
		margin-top: 28px;
	}
	.hero-split .hero-photo {
		width: 100%;
		max-width: 480px;
		height: auto;
		aspect-ratio: 2 / 3;
		justify-self: end;
		border-radius: 100px 22px 22px 22px;
	}
	@media (min-width: 1600px) {
		.hero-photo {
			height: 440px;
		}
	}
	@media (max-width: 1100px) {
		.hero-split {
			column-gap: 40px;
		}
		.hero-type {
			gap: 40px;
			grid-template-columns: 1.3fr 1fr;
		}
	}
	@media (max-width: 760px) {
		.hero-split {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.hero-split .hero-type :global(h1) {
			font-size: clamp(34px, 8.5vw, 60px);
		}
		.hero-split .hero-type {
			padding-top: 0;
		}
		.hero-split .hero-photo {
			height: auto;
			aspect-ratio: 2 / 3;
			margin-top: 32px;
			border-top-left-radius: 70px;
		}
		.ed-hero {
			padding-top: 16px;
		}
		.hero-breadcrumb {
			margin-bottom: 32px;
			font-size: 10px;
			gap: 8px;
		}
		.hero-type {
			grid-template-columns: 1fr;
			gap: 26px;
			margin-bottom: 32px;
		}
		.hero-type :global(h1) {
			font-size: clamp(41px, 8.5vw, 60px);
			overflow-wrap: anywhere;
		}
		.hero-type .ed-kicker {
			font-size: 9px;
			margin-bottom: 20px;
		}
		.hero-aside > p {
			font-size: 15px;
			max-width: 500px;
		}
		.hero-photo {
			height: 330px;
			border-bottom-right-radius: 70px;
		}
		.hero-photo :global(img) {
			object-position: var(--hero-pos-m, center);
		}
		.hero-photo figcaption {
			padding: 22px;
			font-size: 9px;
		}
	}
</style>
