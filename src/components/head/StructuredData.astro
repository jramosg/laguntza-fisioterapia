---
import { Address, Phone, Email, WhatsApp } from '@config/company';
import { Practitioner } from '@config/practitioner';
import { getLangFromUrl } from '@i18n/utils';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const lang = getLangFromUrl(Astro.url);
const { title, description, image } = Astro.props;
const siteUrl = 'https://laguntzafisioterapia.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageImage = new URL(
	image || '/og-image-teal.jpeg',
	Astro.site
).toString();
const businessId = `${siteUrl}#business`;
// E.164 numbers. The mobile is the number on the Google Business Profile, so
// it leads here too: the listing and the markup have to name the same phone.
const mobile = WhatsApp.urlCall.replace('tel:', '');
const landline = Phone.url.replace('tel:', '');
const serviceUrl = (slug: string) => `${siteUrl}/${lang}/services/${slug}/`;
const personId = `${siteUrl}#jokin-ramos`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': ['Physiotherapy', 'MedicalClinic', 'LocalBusiness'],
	'@id': businessId,
	name: 'Laguntza Fisioterapia',
	alternateName: ['Laguntza Fisio', 'Centro de Fisioterapia Laguntza'],
	description:
		lang === 'eu'
			? 'Fisioterapia, osteopatia eta terapia manuala Gipuzkoan. Errehabilitazioan eta ariketa terapeutikoetan espezializatutako zentroa Urnietan.'
			: 'Centro de fisioterapia, osteopatía y terapia manual en Gipuzkoa. Especializado en rehabilitación y ejercicio terapéutico en Urnieta, Guipúzcoa.',
	url: siteUrl,
	logo: {
		'@type': 'ImageObject',
		url: `${siteUrl}/main-logo-horizontal.png`,
		width: 300,
		height: 224
	},
	image: [
		`${siteUrl}/main-logo-horizontal.png`,
		`${siteUrl}/og-image-teal.jpeg`
	],
	sameAs: ['https://www.instagram.com/laguntzafisioterapia'],
	telephone: mobile,
	email: Email.name.replace('mailto:', ''),
	founder: {
		'@id': personId
	},
	contactPoint: [mobile, landline].map(telephone => ({
		'@type': 'ContactPoint',
		telephone,
		contactType: 'reservations',
		availableLanguage: ['Spanish', 'Basque'],
		areaServed: 'ES'
	})),
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Zubitxo Plaza, 3, Bajo 2',
		addressLocality: 'Urnieta',
		addressRegion: 'Gipuzkoa',
		postalCode: '20130',
		addressCountry: 'ES'
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 43.24656113552193,
		longitude: -1.9932571315890595
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday'],
			opens: '08:00',
			closes: '13:30'
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday'],
			opens: '19:30',
			closes: '21:30'
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Thursday'],
			opens: '08:00',
			closes: '13:30'
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '15:00',
			closes: '21:30'
		}
	],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: ['Cash', 'Credit Card', 'Bank Transfer'],
	areaServed: [
		{
			'@type': 'City',
			name: 'Urnieta',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Donostia-San Sebastián',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Hernani',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Andoain',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Lasarte-Oria',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Astigarraga',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Usurbil',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'City',
			name: 'Pasaia',
			containedInPlace: {
				'@type': 'AdministrativeArea',
				name: 'Gipuzkoa'
			}
		},
		{
			'@type': 'AdministrativeArea',
			name: 'Gipuzkoa',
			containedInPlace: {
				'@type': 'Country',
				name: 'España'
			}
		}
	],
	medicalSpecialty: 'Physiotherapy',
	availableService: [
		{ name: 'Fisioterapia', slug: 'fisioterapia-gipuzkoa' },
		{ name: 'Osteopatía', slug: 'osteopatia-gipuzkoa' },
		{ name: 'Terapia manual', slug: 'terapia-manual-gipuzkoa' },
		{
			name: 'Rehabilitación y ejercicio terapéutico',
			slug: 'rehabilitacion-ejercicio-terapeutico-gipuzkoa'
		},
		{ name: 'Punción seca', slug: 'puncion-seca-gipuzkoa' },
		{ name: 'Fisioterapia deportiva', slug: 'fisioterapia-deportiva-gipuzkoa' },
		{ name: 'Neuromodulación' }
	].map(({ name, slug }) => ({
		'@type': 'MedicalTherapy',
		name,
		...(slug && { url: serviceUrl(slug) })
	})),
	hasMap: Address.url,
	knowsAbout: [
		'Fisioterapia',
		'Osteopatía',
		'Terapia manual',
		'Rehabilitación',
		'Ejercicio terapéutico',
		'Punción seca',
		'Neuromodulación',
		'Fisioterapia deportiva'
	]
};

// Professional/Person structured data
const professionalData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': personId,
	name: Practitioner.name,
	jobTitle:
		lang === 'eu' ? 'Fisioterapeuta kolegiatua' : 'Fisioterapeuta colegiado',
	description: Practitioner.sportsRole[lang],
	worksFor: {
		'@id': businessId
	},
	knowsAbout: [
		'Fisioterapia',
		'Osteopatía',
		'Punción Seca',
		'Neuromodulación',
		'Rehabilitación Deportiva',
		'Terapia Manual'
	],
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Universidad Pública de Navarra'
	},
	hasCredential: [
		{
			'@type': 'EducationalOccupationalCredential',
			credentialCategory: 'Professional registration',
			name: `${Practitioner.collegeNameLocalized[lang]} (COFPV)`,
			identifier: Practitioner.registrationNumber,
			recognizedBy: {
				'@type': 'Organization',
				name: Practitioner.collegeName
			}
		},
		...Practitioner.qualifications.map(qualification => ({
			'@type': 'EducationalOccupationalCredential',
			name: qualification[lang]
		}))
	],
	email: Email.name.replace('mailto:', ''),
	telephone: mobile
};

const websiteData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteUrl}#website`,
	name: 'Laguntza Fisioterapia',
	alternateName: 'Laguntza Fisio',
	url: siteUrl,
	inLanguage: ['es', 'eu'],
	publisher: {
		'@id': businessId
	}
};

const webPageData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${pageUrl}#webpage`,
	url: pageUrl,
	name: title,
	description,
	inLanguage: lang,
	isPartOf: {
		'@id': `${siteUrl}#website`
	},
	about: {
		'@id': businessId
	},
	primaryImageOfPage: {
		'@type': 'ImageObject',
		url: pageImage
	}
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<script
	type="application/ld+json"
	set:html={JSON.stringify(professionalData)}
/>
<script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageData)} />
