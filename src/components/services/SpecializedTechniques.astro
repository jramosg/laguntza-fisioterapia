---
import { Icon } from 'astro-icon/components';
import { SERVICES } from '@config/company';
import { getLangFromUrl } from '@i18n/utils';
import { generateSlug } from '@utils/helpers';

const lang = getLangFromUrl(Astro.url);
const section = SERVICES[lang].sections.find(
	service => service.id === 'specialized-techniques'
)!;
---

<section
	id={section.id}
	class="specialized ed-shell ed-section"
	aria-labelledby={generateSlug(section.title)}
>
	<div class="specialized-heading ed-reveal">
		<span class="ed-kicker">
			05 / {lang === 'eu' ? 'TEKNIKAK' : 'TÉCNICAS'}
		</span>
		<h2 id={generateSlug(section.title)} class="ed-heading">
			{section.title}
		</h2>
		<p>
			{lang === 'eu'
				? 'Balorazioaren ondoren, zure egoerari eta helburuei egokitutako teknikak proposatuko dizkizut.'
				: 'Tras la valoración, te propondré las técnicas que se adapten a tu situación y a tus objetivos.'}
		</p>
	</div>
	<div class="techniques">
		{section.bullets?.map(technique => (
			<article class="technique ed-reveal">
				<h3>
					{technique.href ? (
						<a href={`/${lang}/services/${technique.href}/`}>
							{technique.title}
							<Icon name="mdi:arrow-top-right" aria-hidden="true" />
						</a>
					) : (
						technique.title
					)}
				</h3>
				<p>{technique.desc}</p>
			</article>
		))}
	</div>
</section>

<style>
	.specialized {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 80px;
		border-top: 1px solid var(--lf-line);
	}
	.specialized-heading .ed-kicker {
		display: block;
		color: var(--lf-teal);
	}
	.specialized-heading h2 {
		font-size: clamp(34px, 3.5vw, 50px);
	}
	.specialized-heading p {
		margin-top: 28px;
		max-width: 350px;
		font-size: 16px;
		color: var(--lf-muted);
	}
	.techniques {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 36px 40px;
	}
	.technique {
		border-top: 1px solid var(--lf-line);
		padding-top: 24px;
	}
	.technique h3 {
		font-size: 23px;
		line-height: 1.3;
		margin: 0 0 18px;
	}
	.technique a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 44px;
		color: inherit;
		text-decoration: none;
	}
	.technique a:hover {
		color: var(--lf-teal);
	}
	.technique :global(svg) {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
	}
	.technique p {
		font-size: 14px;
		color: var(--lf-muted);
		margin: 0;
	}
	@media (max-width: 1100px) {
		.specialized {
			gap: 40px;
		}
	}
	@media (max-width: 900px) {
		.specialized {
			grid-template-columns: 1fr;
		}
		.specialized-heading p {
			max-width: 560px;
		}
	}
	@media (max-width: 540px) {
		.techniques {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
</style>
