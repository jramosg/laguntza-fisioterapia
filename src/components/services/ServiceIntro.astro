---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	text: string;
	detailText?: string;
	image: any;
	imageAlt: string;
	imagePosition?: string;
}

const {
	title,
	text,
	detailText,
	image,
	imageAlt,
	imagePosition = 'center'
} = Astro.props;
const maxImageWidth = Math.min(image.width, 1280);
const imageWidths = [400, 640, 960].filter(width => width < maxImageWidth);
imageWidths.push(maxImageWidth);
---

<section class="service-intro ed-reveal">
	<div class="service-intro__text">
		<h2>{title}</h2>
		<p>{text}</p>
		{detailText && <p>{detailText}</p>}
	</div>
	<div class="service-intro__image">
		<Image
			src={image}
			alt={imageAlt}
			class="service-image"
			width={Math.min(800, image.width)}
			widths={imageWidths}
			quality={85}
			sizes="(max-width: 768px) 100vw, (max-width: 1024px) 70vw, 500px"
			style={`object-position:${imagePosition}`}
		/>
	</div>
</section>

<style>
	.service-intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s6);
		align-items: center;
		margin-bottom: var(--s8);
	}

	.service-intro__text h2 {
		color: var(--theme-primary);
		margin-bottom: var(--s4);
	}

	.service-intro__text p {
		line-height: 1.8;
		color: var(--theme-on-bg);
	}

	.service-image {
		border-radius: var(--theme-shape-radius);
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	@media (max-width: 768px) {
		.service-intro {
			grid-template-columns: 1fr;
		}

		.service-intro__image {
			order: -1;
		}
	}
</style>
