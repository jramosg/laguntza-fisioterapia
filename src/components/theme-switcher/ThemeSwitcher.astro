---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
const eu = getLangFromUrl(Astro.url) === 'eu';
---

<laguntza-theme-switcher role="group" aria-label={eu ? 'Itxura' : 'Apariencia'}>
	<button type="button" data-theme-choice="light" aria-pressed="false">
		<Icon name="mdi:white-balance-sunny" aria-hidden="true" />
		{eu ? 'Argia' : 'Claro'}
	</button>
	<button type="button" data-theme-choice="dark" aria-pressed="false">
		<Icon name="mdi:weather-night" aria-hidden="true" />
		{eu ? 'Iluna' : 'Oscuro'}
	</button>
</laguntza-theme-switcher>

<script>
	import { chooseTheme, themeChangeEvent } from '@lib/theme';
	class LaguntzaThemeSwitcher extends HTMLElement {
		private controller?: AbortController;
		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const { signal } = this.controller;
			const buttons = this.querySelectorAll<HTMLButtonElement>('button');
			const sync = () => {
				buttons.forEach(button => {
					button.setAttribute(
						'aria-pressed',
						String(
							button.dataset.themeChoice ===
								document.documentElement.dataset.theme
						)
					);
				});
			};
			buttons.forEach(button =>
				button.addEventListener(
					'click',
					() => {
						const theme = button.dataset.themeChoice;
						if (theme === 'light' || theme === 'dark') chooseTheme(theme);
					},
					{ signal }
				)
			);
			document.addEventListener(themeChangeEvent, sync, { signal });
			sync();
		}
		disconnectedCallback() {
			this.controller?.abort();
		}
	}
	if (!customElements.get('laguntza-theme-switcher')) {
		customElements.define('laguntza-theme-switcher', LaguntzaThemeSwitcher);
	}
</script>

<style>
	laguntza-theme-switcher {
		display: inline-flex;
		width: fit-content;
		border: 1px solid #bdd0d580;
		border-radius: 50px;
		padding: 3px;
		gap: 2px;
	}
	laguntza-theme-switcher:not(:defined) {
		display: none;
	}
	button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 13px;
		border: 0;
		border-radius: 30px;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 11px;
		cursor: pointer;
	}
	button[aria-pressed='true'] {
		background: #ffffff24;
		color: #fff;
	}
	button:hover {
		background: #ffffff17;
	}
	button:focus-visible {
		outline: 2px solid #f2b177;
		outline-offset: 3px;
	}
	button :global(svg) {
		width: 15px;
		height: 15px;
	}
</style>
