	/* Hero: one centred panel with a single action, the message box. */
	.hero {
		padding-top: 28px;
		padding-bottom: 56px;
	}
	.hero-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 76px 48px 44px;
		border-radius: 56px;
		background: var(--lf-surface-soft, #eef1eb);
		text-align: center;
	}
	.hero-copy h1 {
		max-width: none;
	}
	.hero-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin-bottom: 30px;
		font-size: 11px;
	}
	.hero-description {
		max-width: 520px;
		margin: 28px auto 0;
		color: var(--lf-text-muted, #65726d);
		font-size: 17px;
		line-height: 1.7;
	}
	.hero-visual {
		width: min(100%, 880px);
		margin-top: 44px;
	}
	.portrait-frame {
		position: relative;
		aspect-ratio: 16 / 10;
		border-radius: 44px;
		overflow: hidden;
		background: var(--lf-surface-accent, #dfe6e1);
	}
	.hero-portrait {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 41% 35%;
	}
	.hero-visual .portrait-caption {
		right: auto;
		text-align: left;
	}
	/* Base look and behaviour of the box live in AskBar.astro. */
	.portrait-frame :global(.ask) {
		position: absolute;
		z-index: 1;
		top: 16px;
		left: 16px;
		right: 16px;
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px 22px;
		margin: 30px 0 0;
		padding: 0;
		list-style: none;
		font-size: 12px;
		color: var(--lf-text-muted, #62716b);
	}
	.hero-meta li {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.hero-meta li::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #e8944a;
	}
	.hero-call {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		margin-top: 8px;
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
	}
	.hero-call a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: inherit;
		border-bottom: 1px solid transparent;
		transition: color 200ms;
	}
	.hero-call a:hover {
		color: var(--teal);
	}
	.hero-call :global(svg) {
		width: 17px;
		height: 17px;
	}
