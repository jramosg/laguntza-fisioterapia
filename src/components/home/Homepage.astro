---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { home } from '@config/home';
import { Address, Phone, WhatsApp, SERVICES } from '@config/company';
import Jokin from '@images/jokin.webp';
import Treatment from '@images/rehab.webp';
import Interview from '@images/interview.webp';
import WaitingRoom from '@images/consulta-espera.jpg';
import Room from '@images/consulta-sala.jpg';
import Mark from '@images/logos/isotipo-white.svg';
import type { Langs } from '@i18n/ui';

interface Props {
	lang: Langs;
}
const { lang } = Astro.props;
const c = home[lang];
const specialized = SERVICES[lang].sections.find(
	service => service.id === 'specialized-techniques'
)!;
const bookingUrl = `${WhatsApp.url}?text=${encodeURIComponent(c.whatsappMessage)}`;
---

<div class="home">
	<section class="hero shell" aria-labelledby="hero-title">
		<div class="hero-panel">
			<div class="hero-copy">
				<h1 id="hero-title">
					<span class="eyebrow hero-eyebrow">
						<span class="location-dot"></span>
						{c.eyebrow}
					</span>
					<span>{c.title[0]}</span>
					<span class="teal">{c.title[1]}</span>
				</h1>
				<p class="hero-description">{c.intro}</p>
			</div>
			<div class="hero-visual">
				<div class="portrait-frame">
					<form
						class="ask"
						data-ask-hero
						action={WhatsApp.url}
						method="get"
						target="_blank"
						data-ask
						data-greeting={c.askGreeting}
						data-fallback={c.whatsappMessage}
						data-examples={JSON.stringify(c.askExamples)}
					>
						<label for="ask-input">{c.askLabel}</label>
						<input
							id="ask-input"
							name="text"
							type="text"
							autocomplete="off"
							maxlength="400"
							placeholder={`${c.askLabel}…`}
						/>
						<span class="ask-example" aria-hidden="true"></span>
						<button type="submit" aria-label={c.askSend}>
							<Icon name="mdi:whatsapp" aria-hidden="true" />
						</button>
					</form>
					<Image
						src={Jokin}
						alt={c.portraitAlt}
						width={1200}
						widths={[480, 800, 1200, 1760]}
						sizes="(max-width: 760px) calc(100vw - 56px), 880px"
						priority
						class="hero-portrait"
					/>
					<div class="portrait-caption">
						<span class="portrait-caption-mark"></span>
						<div>
							<strong>{c.portraitLabel}</strong>
							<span>{c.portraitDetail}</span>
						</div>
					</div>
				</div>
			</div>
			<ul class="hero-meta" role="list">
				{c.heroMeta.map(item => (
					<li>{item}</li>
				))}
			</ul>
			<p class="hero-call">
				<Icon name="mdi:phone-outline" aria-hidden="true" />
				{c.askCall}
				<a href={WhatsApp.urlCall}>{WhatsApp.name}</a>
				<span aria-hidden="true">·</span>
				<a href={Phone.url}>{Phone.name}</a>
			</p>
		</div>
	</section>

	<div class="principles shell">
		<div class="principles-caption">
			<span class="little-line"></span>
			{c.location}
			<br />
			{c.languages}
		</div>
		<div class="principles-words">
			{c.principles.map((word, i) => (
				<span>
					<small>0{i + 1}</small>
					{word}
				</span>
			))}
		</div>
	</div>

	<section
		class="services section-space shell"
		id="cuidarte"
		aria-labelledby="services-title"
	>
		<div class="section-heading">
			<div>
				<p class="eyebrow">{c.servicesLabel}</p>
				<h2 id="services-title">
					{c.servicesTitle[0]}
					<br />
					<span class="muted">{c.servicesTitle[1]}</span>
				</h2>
			</div>
			<div class="section-heading-aside">
				<p>{c.servicesIntro}</p>
				<a class="text-link underlined" href={`/${lang}/services/`}>
					{c.allServices}
					<Icon name="mdi:arrow-top-right" aria-hidden="true" />
				</a>
			</div>
		</div>
		<div class="services-layout">
			<figure class="services-figure">
				<div class="services-image-frame">
					<Image
						src={Treatment}
						alt={c.serviceImageAlt}
						width={900}
						widths={[400, 640, 900]}
						sizes="(max-width: 760px) calc(100vw - 48px), 40vw"
						class="services-image"
					/>
				</div>
				<figcaption>
					<span>{c.serviceImageCaption}</span>
					<span>01—05</span>
				</figcaption>
			</figure>
			<div class="service-list">
				{c.services.map((service, i) => (
					<a class="service-row" href={`/${lang}/services/${service.slug}/`}>
						<>
							<span class="service-number">0{i + 1}</span>
							<div>
								<>
									<h3>{service.title}</h3>
									<p>{service.description}</p>
								</>
							</div>
							<span class="service-arrow">
								<Icon name="mdi:arrow-top-right" aria-hidden="true" />
							</span>
						</>
					</a>
				))}
				<a class="service-row" href={`/${lang}/services/#${specialized.id}`}>
					<span class="service-number">05</span>
					<div>
						<h3>{specialized.title}</h3>
						<p>
							{specialized.bullets
								?.map(technique => technique.title)
								.join(' · ')}
						</p>
					</div>
					<span class="service-arrow">
						<Icon name="mdi:arrow-top-right" aria-hidden="true" />
					</span>
				</a>
			</div>
		</div>
		<div class="reasons">
			<h3 class="eyebrow">{c.reasonsLabel}</h3>
			<ul role="list">
				{c.reasons.map(reason => (
					<li>
						<a href={`/${lang}/services/${reason.slug}/`}>{reason.title}</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="about section-space" aria-labelledby="about-title">
		<div class="shell about-layout">
			<div class="about-images">
				<div class="about-main-image" data-parallax>
					<Image
						src={Interview}
						alt={
							lang === 'eu'
								? 'Jokin, paziente baten balorazioa prestatzen'
								: 'Jokin preparando la valoración de un paciente'
						}
						width={900}
						widths={[400, 640, 900]}
						sizes="(max-width: 760px) 85vw, 38vw"
					/>
				</div>
				<div class="about-detail">
					<Image
						src={Jokin}
						alt=""
						width={440}
						widths={[240, 440]}
						sizes="(max-width: 760px) 38vw, 18vw"
					/>
				</div>
				<span class="photo-index">LAGUNTZA / JOKIN RAMOS</span>
			</div>
			<div class="about-copy">
				<p class="eyebrow">{c.aboutLabel}</p>
				<h2 id="about-title">
					{c.aboutTitle[0]}
					<br />
					<span>{c.aboutTitle[1]}</span>
				</h2>
				<p class="about-lead">{c.aboutLead}</p>
				<p class="about-description">{c.aboutBody}</p>
				<ul class="credentials" role="list">
					{c.credentials.map(credential => (
						<li>
							<span />
							{credential}
						</li>
					))}
				</ul>
				<a class="text-link underlined light-link" href={`/${lang}/about/`}>
					{c.aboutLink}
					<Icon name="mdi:arrow-top-right" aria-hidden="true" />
				</a>
			</div>
		</div>
		<Mark class="about-mark" aria-hidden="true" />
	</section>

	<section
		class="approach section-space shell"
		aria-labelledby="approach-title"
	>
		<div class="section-heading">
			<div>
				<p class="eyebrow">{c.approachLabel}</p>
				<h2 id="approach-title">
					{c.approachTitle[0]}
					<br />
					<span class="muted">{c.approachTitle[1]}</span>
				</h2>
			</div>
			<p class="approach-note">
				{lang === 'eu'
					? 'Zure helburuak. Zure erritmoa. Zure bidea.'
					: 'Tus objetivos. Tu ritmo. Tu camino.'}
			</p>
		</div>
		<ol class="steps" role="list">
			{c.steps.map((step, i) => (
				<li>
					<>
						<span class="step-number">
							0{i + 1}
							<span />
						</span>
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</>
				</li>
			))}
		</ol>
	</section>

	<section class="space-section section-space" aria-labelledby="space-title">
		<div class="shell space-layout">
			<div class="space-copy">
				<p class="eyebrow">{c.spaceLabel}</p>
				<h2 id="space-title">
					{c.spaceTitle[0]}
					<br />
					<span class="muted">{c.spaceTitle[1]}</span>
				</h2>
				<p>{c.spaceText}</p>
				<a class="text-link underlined" href={`/${lang}/consulta/`}>
					{c.spaceLink}
					<Icon name="mdi:arrow-top-right" aria-hidden="true" />
				</a>
				<a
					class="space-location"
					href={Address.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					<Icon name="mdi:map-marker-outline" aria-hidden="true" />
					<span>Zubitxo Plaza, 3 · Urnieta</span>
				</a>
			</div>
			<div class="space-images">
				<figure class="waiting-image" data-parallax>
					<Image
						src={WaitingRoom}
						alt={c.spaceAlt}
						width={760}
						widths={[400, 640, 760]}
						sizes="(max-width: 760px) 70vw, 32vw"
					/>
				</figure>
				<figure class="room-image">
					<Image
						src={Room}
						alt={c.roomAlt}
						width={640}
						widths={[320, 640]}
						sizes="(max-width: 760px) 55vw, 25vw"
					/>
				</figure>
				<span class="space-image-label">ZUBITXO PLAZA · 20130</span>
			</div>
		</div>
	</section>

	<section class="visit shell" aria-labelledby="visit-title">
		<div class="visit-heading">
			<p class="eyebrow">{c.visitLabel}</p>
			<h2 id="visit-title">{c.visitTitle}</h2>
		</div>
		<div class="visit-grid">
			<div>
				<h3 class="eyebrow">{c.visitAddressLabel}</h3>
				<address>
					Zubitxo Plaza, 3 · Bajo 2
					<br />
					20130 Urnieta, Gipuzkoa
				</address>
				<p class="visit-note">{c.visitNote}</p>
				<a
					class="text-link underlined"
					href={Address.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					{c.maps}
					<Icon name="mdi:arrow-top-right" aria-hidden="true" />
				</a>
			</div>
			<div>
				<h3 class="eyebrow">{c.visitHoursLabel}</h3>
				<dl>
					{c.visitHours.map(row => (
						<div>
							<dt>{row.days}</dt>
							<dd>{row.times}</dd>
						</div>
					))}
				</dl>
				<p class="visit-note">{c.heroMeta[0]}</p>
			</div>
			<div>
				<h3 class="eyebrow">{c.visitNearLabel}</h3>
				<dl>
					{c.visitNear.map(row => (
						<div>
							<dt>{row.town}</dt>
							<dd>{row.distance}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="faq section-space shell" aria-labelledby="faq-title">
		<div>
			<p class="eyebrow">{c.faqLabel}</p>
			<h2 id="faq-title">{c.faqTitle}</h2>
			<a class="text-link underlined" href={`/${lang}/contact/`}>
				{c.footerContact}
				<Icon name="mdi:arrow-top-right" aria-hidden="true" />
			</a>
		</div>
		<div class="faq-list">
			{c.faqs.map(faq => (
				<details>
					<>
						<summary>
							{faq.question}
							<Icon name="mdi:plus" aria-hidden="true" />
						</summary>
						<div class="faq-answer">
							<p>{faq.answer}</p>
						</div>
					</>
				</details>
			))}
		</div>
	</section>

	<section class="contact-section" aria-labelledby="contact-title">
		<div class="shell contact-inner">
			<div>
				<p class="eyebrow">{c.contactLabel}</p>
				<h2 id="contact-title">
					{c.contactTitle[0]}
					<br />
					<span>{c.contactTitle[1]}</span>
				</h2>
			</div>
			<div class="contact-aside">
				<p>{c.contactText}</p>
				<a
					class="pill pill-orange"
					href={bookingUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{c.contactWhatsapp}
					<Icon name="mdi:whatsapp" aria-hidden="true" />
				</a>
				<div class="contact-calls">
					<p class="contact-call-label">{c.contactCall}</p>
					<a class="contact-phone" href={Phone.url}>
						<Icon name="mdi:phone-outline" aria-hidden="true" />
						{Phone.name}
					</a>
					<a class="contact-phone" href={WhatsApp.urlCall}>
						<Icon name="mdi:phone-outline" aria-hidden="true" />
						{WhatsApp.name}
					</a>
				</div>
				<small>{c.contactNote}</small>
			</div>
		</div>
	</section>
</div>

<style>
	:global(body.laguntza-home) {
		background: var(--lf-surface-paper, #fbfbf8);
		color: var(--lf-text-primary, #263432);
		max-width: none;
	}
	:global(.laguntza-home .main-content) {
		padding-top: 100px;
	}
	.home {
		--ink: var(--lf-text-primary, #263432);
		--muted: var(--lf-text-muted, #6e7d77);
		--teal: var(--lf-text-accent, #37697a);
		--paper: var(--lf-surface-paper, #fbfbf8);
		--line: var(--lf-border, #263b342b);
		--ease: cubic-bezier(0.16, 1, 0.3, 1);
		background: var(--paper);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.65;
		overflow: clip;
	}
	.home section[id] {
		scroll-margin-top: 120px;
	}
	.shell {
		width: min(100% - 128px, 1312px);
		margin-inline: auto;
	}
	.section-space {
		padding-block: 120px;
	}
	h1,
	h2,
	h3,
	p,
	figure {
		margin: 0;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	a {
		text-decoration: none;
	}
	:global(.home svg[data-icon]) {
		width: 21px;
		height: 21px;
		flex-shrink: 0;
	}
	.eyebrow {
		font-size: 10px;
		line-height: 1.6;
		letter-spacing: 0.12em;
		font-weight: 600;
		text-transform: uppercase;
	}
	.teal {
		color: var(--teal);
	}
	.muted {
		color: var(--muted);
	}
	.reasons {
		margin-top: 72px;
		padding-top: 32px;
		border-top: 1px solid var(--line);
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 40px;
		align-items: start;
	}
	.reasons h3 {
		padding-top: 12px;
		color: var(--lf-text-muted, #5c6b64);
	}
	.reasons ul {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.reasons a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid var(--lf-border-strong, #263b3440);
		border-radius: 60px;
		font-size: 13px;
		font-weight: 500;
		color: var(--ink);
		transition:
			background 200ms,
			border-color 200ms,
			color 200ms;
	}
	.reasons a:hover {
		background: var(--lf-hover-fill, #263b3408);
		border-color: var(--teal);
		color: var(--teal);
	}
	.visit {
		padding-block: 110px 20px;
	}
	.visit-heading .eyebrow {
		margin-bottom: 26px;
	}
	.visit-heading h2 {
		max-width: 760px;
		font-size: clamp(32px, 3.3vw, 46px);
	}
	.visit-grid {
		display: grid;
		grid-template-columns: 1.1fr 1.2fr 1fr;
		gap: 56px;
		margin-top: 56px;
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}
	.visit-grid h3 {
		margin-bottom: 22px;
		color: var(--lf-text-muted, #5c6b64);
	}
	.visit-grid address {
		font-style: normal;
		font-size: 17px;
		line-height: 1.6;
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	.visit-note {
		margin-top: 14px;
		max-width: 320px;
		font-size: 13px;
		line-height: 1.75;
		color: var(--lf-text-muted, #5c6b64);
	}
	.visit-grid .text-link {
		margin-top: 14px;
	}
	.visit-grid dl {
		margin: 0;
	}
	.visit-grid dl > div {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding-block: 12px;
		border-bottom: 1px solid var(--line);
		font-size: 14px;
	}
	.visit-grid dl > div:first-child {
		padding-top: 0;
	}
	.visit-grid dt {
		font-weight: 500;
	}
	.visit-grid dd {
		margin: 0;
		text-align: right;
		color: var(--lf-text-muted, #5c6b64);
		font-variant-numeric: tabular-nums;
	}
	.location-dot {
		width: 6px;
		height: 6px;
		background: #e8944a;
		border-radius: 50%;
	}
	h1 {
		font-size: clamp(60px, 6.4vw, 92px);
		line-height: 1.04;
		letter-spacing: -0.07em;
		font-weight: 700;
		max-width: 770px;
	}
	h1 > span {
		display: block;
	}
	.pill {
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		min-height: 54px;
		padding: 0 26px;
		border-radius: 60px;
		font-size: 13px;
		line-height: 1.3;
		font-weight: 600;
		transition:
			background 250ms,
			transform 350ms var(--ease);
	}
	.pill-orange {
		background: #e8944a;
		color: #202e30;
	}
	.pill-orange:hover {
		background: #f2a35e;
		transform: translateY(-3px);
	}
	.pill-outline {
		border: 1px solid var(--lf-border-strong, #263b3440);
		color: var(--ink);
	}
	.pill-outline:hover {
		background: var(--lf-hover-fill, #263b3408);
		transform: translateY(-3px);
	}
	.text-link {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 20px;
		min-height: 44px;
		font-size: 12px;
		font-weight: 500;
		transition:
			gap 300ms var(--ease),
			color 200ms;
	}
	.text-link:hover {
		gap: 28px;
		color: var(--teal);
	}
	.text-link :global(svg) {
		width: 17px;
		height: 17px;
	}
	.underlined {
		padding-block: 10px;
		border-bottom: 1px solid currentColor;
	}
	.portrait-caption {
		position: absolute;
		bottom: 24px;
		left: 24px;
		right: 24px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 20px;
		background: var(--lf-surface-caption, #fbfbf8ed);
		backdrop-filter: blur(12px);
		border-radius: 12px;
		color: var(--ink);
	}
	.portrait-caption-mark {
		display: block;
		width: 2px;
		height: 28px;
		background: #e8944a;
	}
	.portrait-caption strong,
	.portrait-caption div > span {
		display: block;
	}
	.portrait-caption strong {
		font-size: 13px;
		font-weight: 600;
	}
	.portrait-caption div > span {
		margin-top: 2px;
		font-size: 10px;
		color: var(--lf-text-muted, #5c6b64);
	}
	.principles {
		padding-block: 30px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
	}
	.principles-caption {
		font-size: 10px;
		line-height: 1.9;
		color: var(--lf-text-muted, #66756e);
		position: relative;
		padding-left: 26px;
	}
	.little-line {
		width: 13px;
		height: 1px;
		background: #e8944a;
		position: absolute;
		top: 10px;
		left: 0;
	}
	.principles-words {
		display: flex;
		gap: clamp(28px, 5vw, 80px);
	}
	.principles-words > span {
		display: flex;
		gap: 12px;
