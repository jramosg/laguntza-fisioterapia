---
import Layout from '@layouts/Page.astro';
import SectionHero from '@components/SectionHero.astro';
import FAQ from '@components/sections/FAQ.astro';
import FAQSchema from '@components/head/FAQSchema.astro';
import NextStep from '@components/editorial/NextStep.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { home } from '@config/home';
import { getLangFromUrl, getStaticLangPaths } from '@i18n/utils';
import Interview from '@images/interview.webp';
import Rehab from '@images/rehab.webp';
import Room from '@images/consulta-sala.jpg';
import Prevention from '@images/prevention.webp';
export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = getLangFromUrl(Astro.url);
const c = home[lang];
const images = [Interview, Rehab, Room, Prevention];
const seo = {
	title:
		lang === 'eu'
			? 'Fisioterapia, osteopatia eta eskuzko terapia Urnietan | Laguntza'
			: 'Fisioterapia, osteopatía y terapia manual en Urnieta | Laguntza',
	description:
		lang === 'eu'
			? 'Fisioterapia, terapia manuala, osteopatia eta errehabilitazioa Urnietan. Jokin Ramosekin, zure egoerara egokitutako arreta.'
			: 'Fisioterapia, terapia manual, osteopatía y rehabilitación en Urnieta. Atención adaptada a ti con Jokin Ramos, fisioterapeuta colegiado.',
	breadcrumb: [
		{ name: 'Laguntza Fisioterapia', url: `/${lang}/` },
		{ name: c.nav[0], url: `/${lang}/services/` }
	]
};
---

<Layout {seo}>
	<FAQSchema slot="head" />
	<SectionHero compact eyebrow={c.nav[0]}>
		<h1 slot="title">
			{lang === 'eu' ? 'Zure gorputza.' : 'Tu cuerpo.'}<br /><span
				>{lang === 'eu' ? 'Zure tratamendua.' : 'Tu tratamiento.'}</span
			>
		</h1>
		<Fragment slot="desc">{c.servicesIntro}</Fragment>
	</SectionHero>
	<nav class="service-index ed-shell" aria-label={c.nav[0]}>
		{
			c.services.map((service, i) => (
				<a href={`#service-${i}`}>
					<span>0{i + 1}</span>
					{service.title}
					<Icon name="mdi:arrow-down" aria-hidden="true" />
				</a>
			))
		}
	</nav>
	<div class="ed-shell treatments">
		{
			c.services.map((service, i) => (
				<section
					class:list={[
						'treatment ed-reveal',
						{ 'treatment--reverse': i % 2 === 1 }
					]}
					id={`service-${i}`}
				>
					<>
						<a
							class="treatment-image"
							href={`/${lang}/services/${service.slug}/`}
							aria-label={service.title}
							data-parallax
						>
							<Image
								src={images[i]}
								alt={
									lang === 'eu'
										? `${service.title} Laguntza Fisioterapian, Urnietan`
										: `${service.title} en Laguntza Fisioterapia, Urnieta`
								}
								width={1000}
								widths={[400, 640, 1000]}
								sizes="(max-width:760px) calc(100vw - 48px), 45vw"
							/>
						</a>
						<div class="treatment-copy">
							<>
								<span class="treatment-number">0{i + 1}</span>
								<h2>{service.title}</h2>
								<p>{service.description}</p>
								<a class="ed-link" href={`/${lang}/services/${service.slug}/`}>
									{lang === 'eu'
										? 'Tratamendua ezagutu'
										: 'Conoce el tratamiento'}
									<Icon name="mdi:arrow-top-right" aria-hidden="true" />
								</a>
							</>
						</div>
					</>
				</section>
			))
		}
	</div>
	<section class="ed-section ed-sage">
		<div class="ed-shell ed-intro ed-reveal">
			<div>
				<p class="ed-kicker">{c.approachLabel}</p><h2 class="ed-heading">
					{
						lang === 'eu'
							? 'Zurekin adostutako bidea.'
							: 'Un plan que acordamos contigo.'
					}
				</h2>
			</div><div>
				<p class="ed-lead">
					{
						lang === 'eu'
							? 'Ez duzu jakin behar zein teknika behar duzun. Horretarako dago balorazioa.'
							: 'No necesitas saber qué técnica necesitas. Para eso está la valoración.'
					}
				</p><p class="ed-prose">
					{
						lang === 'eu'
							? 'Zer gertatzen zaizun eta zure helburuak ezagutu ondoren, aukerak azalduko dizkizut. Tratamendua zure egoerara, lehentasunetara eta bilakaerara egokituko dugu.'
							: 'Después de conocer tu situación y tus objetivos, te explicaré las opciones. Adaptaremos el tratamiento a tus necesidades, tus preferencias y tu evolución.'
					}
				</p><a class="ed-link" href={`/${lang}/about/`}
					>{c.aboutLink}<Icon
						name="mdi:arrow-top-right"
						aria-hidden="true"
					/></a
				>
			</div>
		</div>
	</section>
	<div class="ed-shell"><FAQ /></div>
	<NextStep />
</Layout>
<style>
	.service-index {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 26px;
		margin-top: 10px;
		padding-block: 24px 40px;
		border-bottom: 1px solid var(--lf-line);
	}
	.service-index a {
		font-size: 12px;
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		min-height: 48px;
		line-height: 1.5;
	}
	.service-index a > span {
		font-size: 9px;
		color: var(--lf-muted);
	}
	.service-index svg {
		width: 17px;
		height: 17px;
		margin-left: auto;
		flex-shrink: 0;
	}
	.treatments {
		padding-block: 80px 100px;
	}
	.treatment {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 100px;
		align-items: center;
		padding-block: 40px 70px;
	}
	.treatment--reverse .treatment-image {
		order: 2;
	}
	.treatment-image {
		display: block;
		height: 440px;
		border-radius: 22px 100px 22px 22px;
		overflow: hidden;
		background: #e3e8e2;
	}
	.treatment--reverse .treatment-image {
		border-radius: 100px 22px 22px 22px;
	}
	.treatment-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 65% center;
		transition: filter 0.4s;
	}
	.treatment-image:hover img {
		filter: brightness(1.06);
	}
	.treatment-copy {
		max-width: 480px;
	}
	.treatment-number {
		font-size: 13px;
		color: var(--lf-teal);
		display: block;
		padding-bottom: 24px;
		margin-bottom: 28px;
		border-bottom: 1px solid var(--lf-line);
	}
	.treatment h2 {
		font-size: clamp(34px, 3.5vw, 50px);
		line-height: 1.1;
		margin: 0 0 26px;
	}
	.treatment p {
		font-size: 17px;
		color: var(--lf-muted);
		max-width: 350px;
		margin-bottom: 26px;
	}
	@media (max-width: 1100px) {
		.treatment {
			gap: 50px;
		}
		.treatment-image {
			height: 390px;
		}
	}
	@media (max-width: 760px) {
		.service-index {
			grid-template-columns: 1fr 1fr;
			gap: 8px 22px;
			padding-bottom: 28px;
		}
		.service-index a {
			font-size: 11px;
		}
		.treatments {
			padding-block: 32px 60px;
		}
		.treatment {
			grid-template-columns: 1fr;
			gap: 30px;
			padding-block: 25px 45px;
		}
		.treatment--reverse .treatment-image {
			order: 0;
		}
		.treatment-image {
			height: 320px;
		}
		.treatment-number {
			margin-bottom: 20px;
			padding-bottom: 16px;
		}
		.treatment h2 {
			font-size: 36px;
		}
		.treatment p {
			font-size: 16px;
		}
	}
</style>
