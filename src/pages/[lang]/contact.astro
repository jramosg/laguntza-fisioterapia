---
import Layout from '@layouts/Page.astro';
import SectionHero from '@components/SectionHero.astro';
import ContactForm from '@components/forms/ContactForm.astro';
import LeafletMap from '@components/LeafletMap.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, getStaticLangPaths } from '@i18n/utils';
import { home } from '@config/home';
import { Address, Email, Phone, WhatsApp } from '@config/company';
import Entrance from '@images/consulta-entrada.webp';
export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = getLangFromUrl(Astro.url);
const c = home[lang];
const eu = lang === 'eu';
const bookingUrl = `${WhatsApp.url}?text=${encodeURIComponent(c.whatsappMessage)}`;
const seo = {
	title: eu
		? 'Kontaktua eta hitzorduak Urnietan | Laguntza Fisioterapia'
		: 'Contacto y citas en Urnieta | Laguntza Fisioterapia',
	description: eu
		? 'Hartu hitzordua Jokin Ramosekin: WhatsApp 688 734 113 edo 943 036 070. Zubitxo Plaza 3, Urnieta. Ordutegia eta nola iritsi.'
		: 'Pide cita con Jokin Ramos por WhatsApp en el 688 734 113 o por teléfono en el 943 036 070. Zubitxo Plaza 3, Urnieta. Horario y cómo llegar.',
	breadcrumb: [
		{ name: 'Laguntza Fisioterapia', url: `/${lang}/` },
		{ name: c.nav[3], url: `/${lang}/contact/` }
	]
};
const schedule = [
	{
		days: eu ? 'Astelehena eta asteazkena' : 'Lunes y miércoles',
		times: '08:00–13:30 / 19:30–21:30'
	},
	{
		days: eu ? 'Asteartea eta osteguna' : 'Martes y jueves',
		times: '08:00–13:30'
	},
	{ days: eu ? 'Ostirala' : 'Viernes', times: '15:00–21:30' }
];
---

<Layout {seo}>
	<SectionHero compact book={false} eyebrow={c.nav[3]}
		><h1 slot="title">
			{eu ? 'Hitz egingo' : '¿Hablamos'}<br /><span
				>{eu ? 'dugu?' : 'de ti?'}</span
			>
		</h1><Fragment slot="desc"
			>{
				eu
					? 'Hitzordua hartzeko, zalantza bat argitzeko edo zure egoera kontatzeko. Nahiago duzun moduan.'
					: 'Para pedir cita, resolver una duda o contarme qué te pasa. Por el medio que te resulte más cómodo.'
			}</Fragment
		></SectionHero
	>
	<section class="contact-channels ed-shell" aria-label={c.footerContact}>
		<a
			href={bookingUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="channel channel--primary"
			><span class="ed-kicker">01 / WHATSAPP</span><span class="channel-title"
				>{c.book}<Icon name="mdi:arrow-top-right" aria-hidden="true" /></span
			><span class="channel-detail">{WhatsApp.name}</span></a
		><div class="channel channel--calls">
			<span class="ed-kicker">02 / {eu ? 'TELEFONOA' : 'TELÉFONO'}</span><span
				class="channel-title"
				>{c.call}<Icon name="mdi:phone-outline" aria-hidden="true" /></span
			><div class="channel-numbers">
				<a
					href={Phone.url}
					aria-label={`${eu ? 'Deitu telefono finkora' : 'Llamar al fijo'} ${Phone.name}`}
				>
					<span>{eu ? 'Finkoa' : 'Fijo'}</span>{Phone.name}
				</a>
				<a
					href={WhatsApp.urlCall}
					aria-label={`${eu ? 'Deitu mugikorrera' : 'Llamar al móvil'} ${WhatsApp.name}`}
				>
					<span>{eu ? 'Mugikorra' : 'Móvil'}</span>{WhatsApp.name}
				</a>
			</div>
		</div><a href={Email.url} class="channel"
			><span class="ed-kicker">03 / EMAIL</span><span class="channel-title"
				>{eu ? 'Idatzi' : 'Escríbeme'}<Icon
					name="mdi:arrow-top-right"
					aria-hidden="true"
				/></span
			><span class="channel-detail">{Email.name}</span></a
		>
	</section>
	<section class="ed-shell ed-section contact-layout">
		<div class="contact-info ed-sticky">
			<p class="ed-kicker">{eu ? 'ZUBITXO PLAZAN' : 'EN ZUBITXO PLAZA'}</p><h2>
				{eu ? 'Hemen aurkituko nauzu.' : 'Aquí me encontrarás.'}
			</h2><address>
				Zubitxo Plaza, 3 · {eu ? '2. etxabea' : 'Bajo 2'}<br />20130 Urnieta,
				Gipuzkoa
			</address><a
				class="ed-link"
				href={Address.url}
				target="_blank"
				rel="noopener noreferrer"
				>{c.maps}<Icon name="mdi:arrow-top-right" aria-hidden="true" /></a
			><div class="schedule">
				<h3>{eu ? 'Ordutegia' : 'Horario'}</h3><dl>
					{
						schedule.map(row => (
							<div>
								<>
									<dt>{row.days}</dt>
									<dd>{row.times}</dd>
								</>
							</div>
						))
					}
				</dl><p>
					{eu ? 'Aldez aurreko hitzorduarekin' : 'Atención con cita previa'}
				</p>
			</div>
		</div><div class="ed-reveal"><ContactForm /></div>
	</section>
	<section class="ed-sage ed-section">
		<div class="ed-shell location-layout">
			<div class="entrance-photo">
				<Image
					src={Entrance}
					alt={eu
						? 'Laguntza Fisioterapiako sarrera Zubitxo Plazan'
						: 'Entrada de Laguntza Fisioterapia en Zubitxo Plaza'}
					width={600}
					widths={[320, 600]}
					sizes="(max-width:760px) 100vw, 30vw"
				/><span>{eu ? 'Ongi etorri.' : 'Bienvenido. Ongi etorri.'}</span>
			</div><div>
				<p class="ed-kicker">URNIETA · GIPUZKOA</p><h2>
					{eu ? 'Zugandik gertu.' : 'Cerca de ti.'}
				</h2><p class="location-description">
					{
						eu
							? 'Hernani, Andoain eta Donostiatik gertu, Urnietako erdigunean.'
							: 'En el centro de Urnieta, cerca de Hernani, Andoain y Donostia.'
					}
				</p><div class="contact-map">
					<LeafletMap
						latitude={43.24656113552193}
						longitude={-1.9932571315890595}
						zoom={17}
					/>
				</div><a
					class="ed-link"
					href={Address.url}
					target="_blank"
					rel="noopener noreferrer"
					>{c.maps}<Icon name="mdi:arrow-top-right" aria-hidden="true" /></a
				>
			</div>
		</div>
	</section>
</Layout>
<style>
	.contact-channels {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		padding-top: 12px;
	}
	.channel {
		display: block;
		padding: 32px;
		border: 1px solid var(--lf-line);
		border-radius: 18px;
		text-decoration: none;
		transition:
			background 0.3s,
			border-color 0.3s;
	}
	.channel:hover {
		background: #eef1eb;
		border-color: #a5b9b0;
	}
	.channel--primary {
		background: #dce7e6;
		border-color: #dce7e6;
	}
	.channel .ed-kicker {
		display: block;
		margin-bottom: 28px;
		color: var(--lf-muted);
		font-size: 9px;
	}
	.channel-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		font-size: 27px;
		letter-spacing: -0.045em;
		font-weight: 500;
	}
	.channel-title svg {
		width: 22px;
		height: 22px;
		transition: transform 0.35s;
	}
	.channel:hover svg {
		transform: translate(3px, -3px);
	}
	.channel-detail {
		display: block;
		margin-top: 16px;
		font-size: 13px;
		overflow-wrap: anywhere;
		color: var(--lf-muted);
	}
	.channel-numbers {
		margin-top: 12px;
	}
	.channel-numbers a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 44px;
		font-size: 14px;
		text-decoration: none;
	}
	.channel-numbers a + a {
		border-top: 1px solid var(--lf-line);
	}
	.channel-numbers a:hover {
		color: var(--lf-teal);
	}
	.channel-numbers span {
		font-size: 11px;
		color: var(--lf-muted);
	}
	.contact-layout {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 120px;
	}
	.contact-info h2 {
		font-size: 35px;
		max-width: 300px;
		margin-bottom: 26px;
	}
	.contact-info address {
		font-size: 16px;
		font-style: normal;
		line-height: 1.8;
		color: var(--lf-muted);
		margin-bottom: 12px;
	}
	.schedule {
		margin-top: 44px;
	}
	.schedule h3 {
		font-size: 20px;
		margin-bottom: 20px;
	}
	.schedule dl {
		max-width: 350px;
	}
	.schedule dl > div {
		padding-block: 15px;
		border-top: 1px solid var(--lf-line);
	}
	.schedule dt {
		font-size: 13px;
	}
	.schedule dd {
		font-size: 12px;
		color: var(--lf-muted);
		margin: 4px 0 0;
	}
	.schedule > p {
		font-size: 11px;
		color: var(--lf-muted);
	}
	.location-layout {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 90px;
		align-items: center;
	}
	.entrance-photo {
		height: 520px;
		overflow: hidden;
		border-radius: 100px 18px 18px 18px;
		position: relative;
	}
	.entrance-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.entrance-photo > span {
		position: absolute;
		bottom: 24px;
		left: 24px;
		background: #fbfbf8ed;
		padding: 16px 20px;
		border-radius: 10px;
		font-size: 13px;
	}
	.location-description {
		font-size: 15px;
		color: var(--lf-muted);
		margin-bottom: 24px;
	}
	.contact-map {
		height: 300px;
		border-radius: 18px;
		overflow: hidden;
		margin-block: 20px;
	}
	.contact-map :global(.leaflet-map) {
		height: 100%;
	}
	@media (max-width: 1100px) {
		.contact-layout {
			gap: 64px;
		}
		.location-layout {
			gap: 48px;
		}
		.channel {
			padding: 26px;
		}
		.channel-title {
			font-size: 24px;
		}
	}
	@media (max-width: 760px) {
		.contact-channels {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.channel {
			padding: 24px;
		}
		.channel .ed-kicker {
			margin-bottom: 14px;
		}
		.channel-title {
			font-size: 25px;
		}
		.channel-detail {
			margin-top: 10px;
		}
		.contact-layout,
		.location-layout {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		.contact-info h2 {
			font-size: 33px;
		}
		.schedule {
			margin-top: 30px;
		}
		.entrance-photo {
			height: 350px;
		}
		.contact-map {
			height: 280px;
		}
	}
</style>
