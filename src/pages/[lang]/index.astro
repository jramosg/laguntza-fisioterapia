---
import Layout from '@layouts/Base.astro';
import EditorialHeader from '@components/core/EditorialHeader.astro';
import EditorialFooter from '@components/core/EditorialFooter.astro';
import Homepage from '@components/home/Homepage.astro';
import { getLangFromUrl, getStaticLangPaths } from '@i18n/utils';
import { home } from '@config/home';

export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = getLangFromUrl(Astro.url);
const seo = {
	title:
		lang === 'eu'
			? 'Fisioterapia eta osteopatia Gipuzkoan | Laguntza · Urnieta'
			: 'Fisioterapia y osteopatía en Gipuzkoa | Laguntza · Urnieta',
	description:
		lang === 'eu'
			? 'Jokin Ramos naiz, Urnietako fisioterapeuta. Fisioterapia eta osteopatia Gipuzkoan, Hernani, Andoain eta Donostiatik gertu. Hartu hitzordua Laguntzan.'
			: 'Soy Jokin Ramos, fisioterapeuta en Urnieta. Fisioterapia y osteopatía en Gipuzkoa, cerca de Hernani, Andoain y Donostia. Pide cita en Laguntza.'
};
---

<Layout {seo} showWhatsApp={false} bodyClass="laguntza-home">
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: home[lang].faqs.map(({ question, answer }) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer }
			}))
		})}
	/>
	<EditorialHeader slot="header" />
	<Homepage {lang} />
	<EditorialFooter slot="footer" />
</Layout>
