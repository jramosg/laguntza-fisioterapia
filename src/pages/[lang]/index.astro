---
import Layout from '@layouts/Base.astro';
import EditorialHeader from '@components/core/EditorialHeader.astro';
import EditorialFooter from '@components/core/EditorialFooter.astro';
import Homepage from '@components/home/Homepage.astro';
import { getLangFromUrl, getStaticLangPaths } from '@i18n/utils';
import { home } from '@config/home';

export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = getLangFromUrl(Astro.url);
const seo = {
	title:
		lang === 'eu'
			? 'Fisioterapia eta osteopatia Urnietan | Laguntza · Jokin Ramos'
			: 'Fisioterapia y osteopatía en Urnieta | Laguntza · Jokin Ramos',
	description:
		lang === 'eu'
			? 'Jokin Ramos, COFPV 3618 fisioterapeuta Urnietan. Fisioterapia, terapia manuala, osteopatia eta errehabilitazioa. Hartu hitzordua Laguntzan.'
			: 'Soy Jokin Ramos, fisioterapeuta colegiado 3618 en Urnieta. Fisioterapia, terapia manual, osteopatía y rehabilitación. Pide cita en Laguntza.'
};
---

<Layout {seo} showWhatsApp={false} bodyClass="laguntza-home">
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: home[lang].faqs.map(({ question, answer }) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer }
			}))
		})}
	/>
	<EditorialHeader slot="header" />
	<Homepage {lang} />
	<EditorialFooter slot="footer" />
</Layout>
