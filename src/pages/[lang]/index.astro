---
import Layout from '@layouts/Base.astro';
import EditorialHeader from '@components/core/EditorialHeader.astro';
import EditorialFooter from '@components/core/EditorialFooter.astro';
import Homepage from '@components/home/Homepage.astro';
import { getLangFromUrl, getStaticLangPaths } from '@i18n/utils';
import { home } from '@config/home';

export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = getLangFromUrl(Astro.url);
const seo = {
	title:
		lang === 'eu'
			? 'Fisioterapia eta osteopatia Urnietan, Gipuzkoa | Laguntza'
			: 'Fisioterapia y osteopatía en Urnieta, Gipuzkoa | Laguntza',
	description:
		lang === 'eu'
			? 'Fisioterapia, osteopatia eta puntzio lehorra Urnietan, Jokin Ramos fisioterapeuta elkargokidearekin. Hernani, Andoain eta Donostiatik gertu. Hartu hitzordua WhatsApp bidez.'
			: 'Fisioterapia, osteopatía y punción seca en Urnieta con Jokin Ramos, fisioterapeuta colegiado. Cerca de Hernani, Andoain y Donostia. Pide cita por WhatsApp.'
};
---

<Layout {seo} bodyClass="laguntza-home">
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: home[lang].faqs.map(({ question, answer }) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer }
			}))
		})}
	/>
	<EditorialHeader slot="header" />
	<Homepage {lang} />
	<EditorialFooter slot="footer" />
</Layout>
