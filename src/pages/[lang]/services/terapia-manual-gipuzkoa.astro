---
import Layout from '@layouts/Page.astro';
import Container from '@components/core/Container.astro';
import SectionHero from '@components/SectionHero.astro';
import {
	getLangFromUrl,
	getStaticLangPaths,
	useTranslations
} from '@i18n/utils';
import { Langs } from '@i18n/ui';
import Rehab from '@images/rehab.webp';
import DryNeedling from '@images/dry-needling.jpg';
import ServiceIntro from '@components/services/ServiceIntro.astro';
import ServiceGridSection from '@components/services/ServiceGridSection.astro';
import ServiceBenefits from '@components/services/ServiceBenefits.astro';
import ServiceLocation from '@components/services/ServiceLocation.astro';
import ServiceCTA from '@components/services/ServiceCTA.astro';
import ServiceStepper from '@components/services/ServiceStepper.astro';
import ServiceTextSection from '@components/services/ServiceTextSection.astro';
import FAQ from '@components/sections/FAQ.astro';
import ServiceSchema from '@components/head/ServiceSchema.astro';
import ClinicalCareNotice from '@components/services/ClinicalCareNotice.astro';
import RelatedServices from '@components/services/RelatedServices.astro';

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang: Langs = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const seo = {
	title: t('service.manual-therapy.seo-title'),
	description: t('service.manual-therapy.seo-description'),
	breadcrumb: [
		{ name: 'Laguntza Fisioterapia', url: `/${lang}/` },
		{
			name: lang === 'eu' ? 'Zerbitzuak' : 'Servicios',
			url: `/${lang}/services/`
		},
		{
			name: t('service.manual-therapy.hero-title'),
			url: `/${lang}/services/terapia-manual-gipuzkoa/`
		}
	]
};

const manualTherapyTechniques = [
	{
		title: t('service.manual-therapy.technique-1-title'),
		text: t('service.manual-therapy.technique-1-text')
	},
	{
		title: t('service.manual-therapy.technique-2-title'),
		text: t('service.manual-therapy.technique-2-text')
	},
	{
		title: t('service.manual-therapy.technique-3-title'),
		text: t('service.manual-therapy.technique-3-text')
	},
	{
		title: t('service.manual-therapy.technique-4-title'),
		text: t('service.manual-therapy.technique-4-text')
	}
];

const manualTherapyBenefits = [
	t('service.manual-therapy.benefit-1'),
	t('service.manual-therapy.benefit-2'),
	t('service.manual-therapy.benefit-3'),
	t('service.manual-therapy.benefit-4'),
	t('service.manual-therapy.benefit-5')
];

const manualTherapySession = [1, 2, 3, 4].map(step => ({
	title: t(`service.manual-therapy.session-${step}-title`),
	text: t(`service.manual-therapy.session-${step}-text`)
}));

const manualTherapyFaq = [1, 2, 3, 4].map(item => ({
	q: t(`service.manual-therapy.faq-${item}-q`),
	a: t(`service.manual-therapy.faq-${item}-a`)
}));
---

<Layout {seo}>
	<ServiceSchema
		slot="head"
		name={t('service.manual-therapy.hero-title')}
		description={t('service.manual-therapy.seo-description')}
	/>
	<SectionHero
		id="manual-therapy-hero"
		image={DryNeedling}
		imageAlt={lang === 'eu'
			? 'Puntzio lehorra Laguntza Fisioterapian, Urnietan'
			: 'Punción seca en Laguntza Fisioterapia, Urnieta'}
		imagePosition="center 62%"
	>
		<h1 slot="title">
			{t('service.manual-therapy.hero-title')}
		</h1>
		<Fragment slot="desc">
			{t('service.manual-therapy.hero-subtitle')}
		</Fragment>
	</SectionHero>

	<Container class="service-page">
		<article class="service-content">
			<ServiceIntro
				title={t('service.manual-therapy.what-is-title')}
				text={t('service.manual-therapy.what-is-text')}
				detailText={t('service.manual-therapy.deep-text')}
				image={Rehab}
				imageAlt={t('service.manual-therapy.hero-title')}
			/>

			<ClinicalCareNotice {lang} />

			<ServiceStepper
				title={t('service.manual-therapy.session-title')}
				items={manualTherapySession}
			/>

			<ServiceGridSection
				title={t('service.manual-therapy.techniques-title')}
				items={manualTherapyTechniques}
			/>

			<ServiceBenefits
				title={t('service.manual-therapy.benefits-title')}
				benefits={manualTherapyBenefits}
			/>

			<ServiceTextSection
				title={t('service.manual-therapy.sessions-title')}
				paragraphs={[
					t('service.manual-therapy.sessions-text'),
					t('service.manual-therapy.safety-text')
				]}
			/>

			<FAQ
				id="manual-therapy-faq-title"
				title={t('service.manual-therapy.faq-title')}
				items={manualTherapyFaq}
				compact
			/>

			<RelatedServices current="terapia-manual-gipuzkoa" />

			<ServiceLocation />

			<ServiceCTA />
		</article>
	</Container>
</Layout>

<style>
	.service-page {
		padding-top: var(--s6);
		padding-bottom: var(--s6);
	}

	.service-content {
		max-width: 900px;
		margin: 0 auto;
	}
</style>
