---
import Layout from '@layouts/Page.astro';
import {
	getLangFromUrl,
	getStaticLangPaths,
	useTranslations
} from '@i18n/utils';
import { Langs } from '@i18n/ui';
import SectionHero from '@components/SectionHero.astro';
import AboutSection from '@components/sections/AboutSection.astro';
import JokinImage from '@images/jokin.webp';
import { Practitioner } from '@config/practitioner';

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang: Langs = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// SEO data for about page - optimized for Gipuzkoa keywords
const seo = {
	title:
		lang === 'eu'
			? `${Practitioner.name} | Fisioterapeuta Urnietan, Gipuzkoan`
			: `${Practitioner.name} | Fisioterapeuta en Urnieta, Gipuzkoa`,
	description:
		lang === 'eu'
			? `Ezagutu ${Practitioner.name}, COFPVko ${Practitioner.registrationNumber} zenbakiko Urnietako fisioterapeuta kolegiatua. UPNAko gradua, fisioterapia inbaditzaileko, kirol erreadaptazioko eta egiturazko osteopatiako masterrak.`
			: `Conoce a ${Practitioner.name}, fisioterapeuta en Urnieta, colegiado COFPV n.º ${Practitioner.registrationNumber}. Graduado en la UPNA, con másteres en Fisioterapia Invasiva, Readaptación Deportiva y Osteopatía Estructural.`,
	breadcrumb: [
		{ name: 'Laguntza Fisioterapia', url: `/${lang}/` },
		{
			name: lang === 'eu' ? 'Niri buruz' : 'Sobre mí',
			url: `/${lang}/about/`
		}
	]
};
---

<Layout {seo}>
	<SectionHero
		id="about-hero"
		image={JokinImage}
		imageAlt={Practitioner.name}
		imagePosition="center 34%"
		imageMobilePosition="center 24%"
	>
		<h1 slot="title" class="title--highlight">
			{t('about.title')}
		</h1>
		<Fragment slot="desc">
			{t('about.subtitle')}
		</Fragment>
	</SectionHero>
	<AboutSection lang={lang} />
</Layout>
