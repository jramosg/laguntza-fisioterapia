---
import Layout from '@layouts/Page.astro';
import { Icon } from 'astro-icon/components';
const seo = {
	title: 'Orrialdea ez da aurkitu · Página no encontrada | Laguntza',
	description: 'Vuelve a Laguntza Fisioterapia en Urnieta. Hasiera · Inicio.',
	noindex: true
};
---

<Layout {seo}>
	<section class="ed-shell missing-page">
		<p class="ed-kicker">404 / LAGUNTZA FISIOTERAPIA</p><h1>
			<span lang="eu">Orrialdea ez da aurkitu.</span><span lang="es"
				>Página no encontrada.</span>
		</h1><p lang="eu">
			Bilatzen ari zaren orrialdea ez dago hemen. Hasieratik jarrai dezakegu.
		</p><p lang="es">
			La página que buscas no está aquí. Podemos seguir desde el inicio.
		</p><div>
			<a class="ed-pill" href="/eu/" lang="eu"
				>Hasierara itzuli<Icon
					name="mdi:arrow-top-right"
					aria-hidden="true"
				/></a
			><a class="ed-link" href="/es/" lang="es"
				>Volver al inicio<Icon
					name="mdi:arrow-top-right"
					aria-hidden="true"
				/></a>
		</div>
	</section>
</Layout>
<style>
	.missing-page {
		padding-block: 100px 130px;
		min-height: 70vh;
	}
	h1 {
		font-size: clamp(36px, 5.2vw, 76px);
		line-height: 1.1;
		letter-spacing: -0.06em;
		max-width: 1050px;
		margin-bottom: 40px;
		overflow-wrap: anywhere;
	}
	h1 span {
		display: block;
	}
	h1 span:last-child {
		color: #37697a;
	}
	p:not(.ed-kicker) {
		font-size: 15px;
		color: #5c6b64;
		max-width: 550px;
		margin-bottom: 12px;
	}
	.missing-page > div {
		display: flex;
		gap: 32px;
		align-items: center;
		flex-wrap: wrap;
		margin-top: 36px;
	}
	@media (max-width: 760px) {
		.missing-page {
			padding-block: 64px 80px;
		}
	}
</style>
