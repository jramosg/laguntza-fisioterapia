---
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Header from '@components/core/EditorialHeader.astro';
import Footer from '@components/core/EditorialFooter.astro';
export interface Props {
	seo?: BaseHeadProps;
}

const { seo } = Astro.props as Props;
---

<Layout {seo} bodyClass="laguntza-interior">
	<slot name="head" slot="head" />
	<Header slot="header" />
	<div id="page">
		<slot />
	</div>
	<Footer slot="footer" />
</Layout>
