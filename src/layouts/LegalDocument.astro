---
import Layout from './Page.astro';
import { Email } from '@config/company';

interface Props {
	lang: 'eu' | 'es';
	kind: 'privacy' | 'legal';
	title: string;
	introduction: string;
	sections: { id: string; label: string }[];
	updated?: string;
}

const { lang, kind, title, introduction, sections, updated } = Astro.props;
const eu = lang === 'eu';
const documents = [
	{ id: 'privacy', label: eu ? 'Pribatutasuna' : 'Privacidad' },
	{ id: 'legal', label: eu ? 'Lege-oharra' : 'Aviso legal' }
];
---

<Layout seo={{ title: `${title} | Laguntza Fisioterapia`, noindex: true }}>
	<article class="legal-document" aria-labelledby="document-title">
		<header class="document-header">
			<div class="document-meta">
				<p class="ed-kicker">LAGUNTZA FISIOTERAPIA</p>
				<nav aria-label={eu ? 'Lege-informazioa' : 'Información legal'}>
					{documents.map(document => (
						<a
							href={`/${lang}/${document.id}/`}
							aria-current={kind === document.id ? 'page' : undefined}
						>
							{document.label}
						</a>
					))}
				</nav>
			</div>
			<h1 id="document-title">{title}</h1>
			<p class="document-introduction">{introduction}</p>
		</header>
		<div class="document-layout">
			<aside class="document-sidebar">
				<nav
					aria-label={
						eu ? 'Orrialde honetako edukiak' : 'Contenido de esta página'
					}
				>
					<p class="ed-kicker">{eu ? 'ORRIALDE HONETAN' : 'EN ESTA PÁGINA'}</p>
					<ol>
						{sections.map((section, index) => (
							<li>
								<a href={`#${section.id}`}>
									<span class="section-number" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span>{section.label}</span>
								</a>
							</li>
						))}
					</ol>
				</nav>
				<div class="document-help">
					<p>
						{eu ? 'Zalantzarik baduzu, idatzi.' : 'Si tienes dudas, escríbeme.'}
					</p>
					<a href={Email.url}>{Email.name}</a>
				</div>
			</aside>
			<div class="document-copy">
				<slot />
			</div>
		</div>
		<footer class="document-footer">
			{updated && <p>{updated}</p>}
			<a href={`/${lang}/contact/`} class="ed-link">
				{eu ? 'Kontsultarekin harremanetan jarri' : 'Contactar con la consulta'}
			</a>
		</footer>
	</article>
</Layout>

<style>
	.legal-document {
		box-sizing: border-box;
		width: 100%;
		max-width: 1440px;
		margin-inline: auto;
		padding: clamp(44px, 6.5vw, 96px) clamp(24px, 4.5vw, 64px)
			clamp(80px, 10vw, 144px);
	}
	.document-header {
		padding-bottom: clamp(40px, 5vw, 72px);
		border-bottom: 1px solid var(--lf-line);
	}
	.document-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
		flex-wrap: wrap;
	}
	.document-meta .ed-kicker {
		margin: 0;
		color: var(--lf-teal);
	}
	.document-meta nav {
		display: flex;
		gap: 28px;
	}
	.document-meta a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 13px;
		color: var(--lf-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.document-meta a[aria-current='page'] {
		color: var(--lf-ink);
		border-bottom-color: currentColor;
	}
	.document-header h1 {
		font-size: clamp(36px, 8vw, 104px);
		line-height: 1.02;
		letter-spacing: -0.06em;
		font-weight: 700;
		margin: clamp(36px, 5vw, 64px) 0 26px;
	}
	.document-introduction {
		max-width: 640px;
		font-size: clamp(17px, 1.7vw, 21px);
		line-height: 1.65;
		color: var(--lf-muted);
		margin: 0;
	}
	.document-layout {
		display: grid;
		grid-template-columns: minmax(200px, 0.85fr) minmax(0, 2.35fr);
		column-gap: clamp(56px, 7vw, 112px);
		padding-top: clamp(40px, 5vw, 72px);
		align-items: start;
	}
	.document-sidebar {
		position: sticky;
		top: 132px;
		align-self: start;
	}
	.document-sidebar .ed-kicker {
		margin-bottom: 18px;
		color: var(--lf-muted);
	}
	.document-sidebar ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.document-sidebar li + li {
		margin-top: 4px;
	}
	.document-sidebar nav a {
		display: flex;
		align-items: baseline;
		gap: 16px;
		min-height: 44px;
		padding-block: 10px;
		color: var(--lf-ink);
		font-size: 14px;
		line-height: 1.6;
		text-decoration: none;
	}
	.section-number {
		font-size: 10px;
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
		color: var(--lf-teal);
	}
	.document-sidebar a:hover,
	.document-meta a:hover {
		color: var(--lf-teal);
	}
	.document-help {
		margin-top: 36px;
		padding-top: 24px;
		border-top: 1px solid var(--lf-line);
		font-size: 12px;
		line-height: 1.8;
		color: var(--lf-muted);
	}
	.document-help p {
		margin: 0 0 6px;
	}
	.document-help a {
		display: inline-block;
		padding-block: 8px;
		color: var(--lf-ink);
		text-underline-offset: 0.25em;
		overflow-wrap: anywhere;
	}
	.document-copy {
		min-width: 0;
		max-width: 760px;
		font-size: clamp(16px, 1.2vw, 17px);
		line-height: 1.85;
		color: var(--lf-muted);
	}
	.document-copy :global(section) {
		scroll-margin-top: 132px;
	}
	.document-copy :global(section + section) {
		margin-top: clamp(36px, 4vw, 56px);
		padding-top: clamp(32px, 3vw, 44px);
		border-top: 1px solid var(--lf-line);
	}
	.document-copy :global(h2) {
		font-size: clamp(23px, 2.3vw, 30px);
		line-height: 1.25;
		letter-spacing: -0.04em;
		color: var(--lf-ink);
		margin: 0 0 22px;
	}
	.document-copy :global(p) {
		margin: 0;
	}
	.document-copy :global(p + p) {
		margin-top: 18px;
	}
	.document-copy :global(a) {
		color: var(--lf-teal);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		overflow-wrap: anywhere;
	}
	.document-copy :global(dl) {
		margin: 0;
	}
	.document-copy :global(dl > div) {
		display: grid;
		grid-template-columns: minmax(110px, 0.7fr) minmax(0, 2fr);
		gap: 16px;
		padding-block: 18px;
		border-bottom: 1px solid var(--lf-line);
	}
	.document-copy :global(dl > div:first-child) {
		padding-top: 0;
	}
	.document-copy :global(dt) {
		font-size: 12px;
		font-weight: 500;
		color: var(--lf-ink);
	}
	.document-copy :global(dd) {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.document-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: clamp(56px, 6vw, 88px);
		padding-top: 28px;
		border-top: 1px solid var(--lf-line);
	}
	.document-footer p {
		margin: 0;
		font-size: 12px;
		color: var(--lf-muted);
	}
	@media (max-width: 900px) {
		.document-layout {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.document-sidebar {
			position: static;
			padding-bottom: 24px;
			border-bottom: 1px solid var(--lf-line);
		}
		.document-sidebar ol {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 16px;
		}
		.document-sidebar nav a {
			font-size: 13px;
			gap: 12px;
		}
		.document-sidebar li + li {
			margin-top: 0;
		}
		.document-help {
			display: none;
		}
		.document-copy {
			max-width: 100%;
		}
	}
	@media (max-width: 480px) {
		.document-meta {
			align-items: flex-start;
			flex-direction: column;
			gap: 16px;
		}
		.document-meta nav {
			gap: 24px;
		}
		.document-copy :global(dl > div) {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
