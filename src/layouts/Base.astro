---
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import { getLangFromUrl } from '@i18n/utils';
import WhatsAppFab from '@components/WhatsAppFab.astro';
import '@fontsource-variable/inter';
import '../styles/editorial.css';
import SiteMotion from '@components/core/SiteMotion.astro';
export interface Props {
	seo?: BaseHeadProps;
	showWhatsApp?: boolean;
	bodyClass?: string;
}

const { seo, showWhatsApp = true, bodyClass } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
	<head>
		<BaseHead {...seo} />
		<slot name="head" />
	</head>

	<body class={bodyClass} itemscope itemtype="https://schema.org/WebPage">
		<a href="#content" class="skip-to-content">
			{lang === 'eu' ? 'Edukira joan' : 'Saltar al contenido'}
		</a>
		<slot name="header" />
		<main id="content" class="main-content">
			<slot />
		</main>
		{showWhatsApp && <WhatsAppFab />}
		<slot name="footer" />
		<SiteMotion />
	</body>
</html>

<style>
	.main-content {
		padding-top: var(--header-height);
	}

	.skip-to-content {
		position: fixed;
		top: -100%;
		left: var(--s2);
		z-index: 9999;
		padding: var(--s2) var(--s4);
		background: var(--theme-primary-800, #234652);
		color: #fff;
		font-weight: 600;
		border-radius: 0 0 var(--theme-shape-radius) var(--theme-shape-radius);
		text-decoration: none;
		transition: top 0.2s;
	}
	.skip-to-content:focus {
		top: 0;
	}
</style>
